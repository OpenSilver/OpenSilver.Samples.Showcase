<UserControl
    x:Class="OpenSilver.Samples.Showcase.DevExpressDateEdit_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">


    <ContentControl Style="{StaticResource Card_Style}" Width="300">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="DateEdit" Foreground="#FF7F5EA4" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>

            <Grid Grid.Row="1">
                <StackPanel>
                    <razor:RazorComponent x:Name="RichEditComponentHolder" Height="50">
                        @using global::DevExpress.Blazor
                        <DxDateEdit @bind-Date="{Binding Date, Mode=TwoWay, Type=DateTime}"
                                    TimeSectionVisible="false"
                                    NullText="Select a date..."
                                    CssClass="cw-320"/>
                    </razor:RazorComponent>

                    <TextBlock Text="{Binding TextForTextBox}"/>
                </StackPanel>
            </Grid>

            <local:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <local:ViewSourceButton.Sources>
                    <local:ViewDevExpressSourceInfo RelativePath="OpenSilver.Samples.Showcase.DevExpress/Samples/DateEdit"
FileName="DevExpressDateEdit_Demo.xaml" />
                    <local:ViewDevExpressSourceInfo RelativePath="OpenSilver.Samples.Showcase.DevExpress/Samples/DateEdit"
FileName="DevExpressDateEdit_Demo.xaml.cs" />
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
