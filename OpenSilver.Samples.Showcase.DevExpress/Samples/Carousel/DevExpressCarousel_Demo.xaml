<UserControl
    x:Class="OpenSilver.Samples.Showcase.DevExpressCarousel_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">


    <ContentControl Style="{StaticResource Card_Style}" Width="550">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Carousel" Foreground="#FF7F5EA4" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>

            <Grid Grid.Row="1">
                <StackPanel>
                    <razor:RazorComponent x:Name="RichEditComponentHolder" Height="350">
                        @using global::DevExpress.Blazor
@using OpenSilver.Samples.Showcase.DevExpressModel
                        <DxCarousel Width="500px"
                                    Height="300px"
                                    Data="{Binding}"
                                    LoopNavigationEnabled="true"
                                    SlideShowEnabled="true"
                                    SlideShowDelay="5000"
                                    NavButtonsDisplayMode="CarouselControlsDisplayMode.AlwaysVisible"
                                    ImageSizeMode="CarouselImageSizeMode.FillAndCrop"
                                    PagerDisplayMode="CarouselControlsDisplayMode.AlwaysVisible"
                                    CssClass="demo-carousel-container">
                            <ItemTemplate>
                                @{
                                    var item = context.DataItem as Planet;
                                }
                                <div class="caruselItemContainer">
                                    <p class="caruselItemCaption">@item?.Name</p>
                                    <img src="@item?.ImagePath" alt="@item?.Name" />
                                </div>
                            </ItemTemplate>
                        </DxCarousel>
                        @code {
    DateTime Date = DateTime.Today;
                            }
                    </razor:RazorComponent>

                    <TextBlock Text="{Binding TextForTextBox}"/>
                </StackPanel>
            </Grid>

            <!--<local:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
    <local:ViewSourceButton.Sources>
        <local:ViewSourceButtonInfo RelativePath="OpenSilver.Samples.Showcase.MudBlazor/Samples"
                                    FileName="MudBlazorColorPicker_Demo.xaml" />
        <local:ViewSourceButtonInfo RelativePath="OpenSilver.Samples.Showcase.MudBlazor/Samples"
                                    FileName="MudBlazorColorPicker_Demo.xaml.cs" />
        <local:ViewSourceButtonInfo RelativePath="OpenSilver.Samples.Showcase.MudBlazor/Samples"
                                    FileName="Employees.cs" />
    </local:ViewSourceButton.Sources>
</local:ViewSourceButton>-->
        </Grid>
    </ContentControl>
</UserControl>
