<UserControl x:Class="OpenSilver.Showcase.GetResourceStream_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}"
                    Width="245">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="GetResourceStream"
                            Foreground="#FF89B8AD"
                            Background="#FF8FCBBE"
                            Style="{StaticResource HeaderControl_Style}" />
            <StackPanel Grid.Row="1"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,0">
                <Button Content="View SampleText.txt"
                        Click="ViewFile_Click"
                        Margin="0,0,0,10" />
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2"
                                    Margin="0,15,0,0"
                                    Background="#FF3ED4B2">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/GetResourceStream"
                                                FileName="GetResourceStream_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/GetResourceStream"
                                                FileName="GetResourceStream_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/GetResourceStream"
                                                FileName="GetResourceStream_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/GetResourceStream"
                                                FileName="GetResourceStream_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
