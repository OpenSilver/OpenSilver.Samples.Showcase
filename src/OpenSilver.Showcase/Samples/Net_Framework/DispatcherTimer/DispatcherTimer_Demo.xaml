<UserControl
    x:Class="OpenSilver.Showcase.DispatcherTimer_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}" Width="245">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="DispatcherTimer" Foreground="#FFDEA542" Background="#FFD2BD9C" Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Start" Click="ButtonToStartTimer_Click"/>
                    <Button Content="Stop" Margin="5,0,0,0" Click="ButtonToStopTimer_Click"/>
                </StackPanel>
                <TextBlock x:Name="CounterTextBlock" Margin="0,10,0,0" FontSize="26" HorizontalAlignment="Center" Text="0"/>
            </StackPanel>

            <shared:ViewSourceButton Grid.Row="2"
                                    Background="#FCAB54">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/DispatcherTimer"
                                                FileName="DispatcherTimer_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/DispatcherTimer"
                                                FileName="DispatcherTimer_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/DispatcherTimer"
                                                FileName="DispatcherTimer_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/DispatcherTimer"
                                                FileName="DispatcherTimer_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
