<UserControl
    x:Class="OpenSilver.Showcase.UnhandledException_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}" Width="245">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="UnhandledException" Foreground="#FFDEA542" Background="#FFD2BD9C" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <Button Grid.Row="1" Content="Throw Exception" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ButtonThrowException_Click"/>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2"
                                Background="#FCAB54">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/UnhandledException"
                                            FileName="UnhandledException_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/UnhandledException"
                                            FileName="UnhandledException_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/UnhandledException"
                                            FileName="UnhandledException_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/UnhandledException"
                                            FileName="UnhandledException_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
