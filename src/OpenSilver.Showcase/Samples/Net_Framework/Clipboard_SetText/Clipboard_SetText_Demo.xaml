<UserControl
    x:Class="OpenSilver.Showcase.Clipboard_SetText_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}" Width="245">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Set Clipboard Text" Foreground="#FFFF7C79" Background="#FFC78F8F" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Type some text:"/>
                <TextBox x:Name="ClipboardTextBox"/>
                <Button Content="Copy text." Click="Button_Click"/>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2"
                                    Background="#FFFF7C79">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/Clipboard_SetText"
                                                FileName="Clipboard_SetText_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/Clipboard_SetText"
                                                FileName="Clipboard_SetText_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/Clipboard_SetText"
                                                FileName="Clipboard_SetText_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Net_Framework/Clipboard_SetText"
                                                FileName="Clipboard_SetText_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
