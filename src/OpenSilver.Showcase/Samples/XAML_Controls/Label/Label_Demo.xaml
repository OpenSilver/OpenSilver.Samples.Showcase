<UserControl
    x:Class="OpenSilver.Showcase.Label_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
  <ContentControl Style="{StaticResource Card_Style}" Width="200">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ContentControl Content="Label" Foreground="#FFFCAB54" Background="#FFCCA376" Style="{StaticResource HeaderControl_Style}"/>
      <StackPanel Grid.Row="1">
        <sdk:Label Content="Non-Styled label">
        </sdk:Label>     
        <Border Margin="0,10,0,0">
          <sdk:Label Content="Styled label">
            <sdk:Label.Style>
              <Style TargetType="sdk:Label">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="sdk:Label">
                      <Border CornerRadius="10" Padding="6" BorderThickness="1" BorderBrush="Blue" Width="75" HorizontalAlignment="Left">
                        <TextBlock Text="{TemplateBinding Content}" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </sdk:Label.Style>
          </sdk:Label>
        </Border>     
      </StackPanel>
            <shared:ViewSourceButton Grid.Row="2"
                                    Background="#FCAB54">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Label"
                                                FileName="Label_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Label"
                                                FileName="Label_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Label"
                                                FileName="Label_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Label"
                                                FileName="Label_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
    </Grid>
  </ContentControl>
</UserControl>
