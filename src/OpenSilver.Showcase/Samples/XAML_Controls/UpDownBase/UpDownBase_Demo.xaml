<UserControl x:Class="OpenSilver.Showcase.UpDownBase_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Showcase"
             xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Width="200">

    <ContentControl Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="UpDownBase"
                            Foreground="#FFD6AA17"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1">
                <TextBlock VerticalAlignment="Center" Text="UpDownBase&lt;int&gt;"/>
                <local:IntUpDown Margin="10,5,10,20" VerticalContentAlignment="Center"/>

                <TextBlock VerticalAlignment="Center" Text="UpDownBase&lt;DateTime&gt;"/>
                <local:DateTimeUpDown Margin="10,5,10,20" VerticalContentAlignment="Center"/>

                <TextBlock VerticalAlignment="Center" Text="UpDownBase&lt;string&gt;"/>
                <local:StringUpDown Margin="10,5,10,20" VerticalContentAlignment="Center"/>
            </StackPanel>

            <shared:ViewSourceButton Grid.Row="3" Background="#FFD6AA17">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo FileName="UpDownBase_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/UpDownBase"/>
                    <shared:ViewSourceButtonInfo FileName="UpDownBase_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/UpDownBase"/>
                    <shared:ViewSourceButtonInfo FileName="UpDownBase_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/UpDownBase"/>
                    <shared:ViewSourceButtonInfo FileName="UpDownBase_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/UpDownBase"/>
                    <shared:ViewSourceButtonInfo FileName="CustomUpDowns.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/UpDownBase"/>
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
