<UserControl x:Class="OpenSilver.Showcase.ToolTip_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Width="200" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Background="#FFBEDCA4"
                            Content="ToolTip"
                            Foreground="#FFB3BFA9"
                            Style="{StaticResource HeaderControl_Style}"/>

            <Button Grid.Row="1"
                    Padding="7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    ToolTip="This is the ToolTip">
                <TextBlock Text="Button with text ToolTip inline"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Button>

            <Button Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ToolTipService.ToolTip>
                    <Image Width="100"
                           Height="100"
                           Source="ms-appx:/Other/Logo.png"
                           Stretch="Fill"/>
                </ToolTipService.ToolTip>
                <TextBlock Text="Button with image ToolTip as direct child"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Button>

            <Button Grid.Row="3"
                    Margin="0,10,0,0"
                    Padding="7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom">
                <ToolTipService.ToolTip>
                    <ToolTip Background="{DynamicResource Theme_PrimaryBrush}"
                             HorizontalOffset="50"
                             Placement="Bottom"
                             VerticalOffset="10">
                        <ToolTip.Template>
                            <ControlTemplate TargetType="ToolTip">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Path Width="20"
                                              Height="10"
                                              Margin="20,-10,0,-1"
                                              HorizontalAlignment="Left"
                                              Canvas.ZIndex="2"
                                              Data="M0,10 L10,0 20,10Z"
                                              Fill="{TemplateBinding Background}"/>
                                        <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ToolTip.Template>
                        <Image Width="100"
                               Height="100"
                               Source="ms-appx:/Other/Logo.png"
                               Stretch="Uniform"/>
                    </ToolTip>
                </ToolTipService.ToolTip>
                <TextBlock Text="Button with custom ToolTip style"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Button>

            <shared:ViewSourceButton Grid.Row="4"
                                    Margin="0,10,0,0"
                                    Background="#FFBEDCA4">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo FileName="ToolTip_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/ToolTip"/>
                    <shared:ViewSourceButtonInfo FileName="ToolTip_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/ToolTip"/>
                    <shared:ViewSourceButtonInfo FileName="ToolTip_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/ToolTip"/>
                    <shared:ViewSourceButtonInfo FileName="ToolTip_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/ToolTip"/>
                    <shared:ViewStyleSourceInfo TabHeader="Default ToolTip Style" Fragment="#L1788-L1835"/>
                    <shared:ViewModernStyleSourceInfo TabHeader="Modern ToolTip Style" Fragment="#L3288-L3317"/>
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
