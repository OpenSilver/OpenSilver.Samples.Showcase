<UserControl x:Class="OpenSilver.Showcase.RichTextBox_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Width="200" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="RichTextBox"
                            Foreground="#FF716AD1"
                            Style="{StaticResource HeaderControl_Style}"/>

            <RichTextBox Grid.Row="1"
                         Margin="10,20"
                         FontSize="14">
                <Paragraph>
                    <Run Text="This is a sample RichTextBox. You can format text, insert images, and more."/>
                </Paragraph>
                <Paragraph>
                    <Bold>
                        This text is bold.
                    </Bold>
                    <Italic>
                        This text is italic.
                    </Italic>
                </Paragraph>
                <Paragraph TextAlignment="Center">
                    <InlineImageContainer Height="40" Source="/OpenSilver.Showcase;component/Other/Planets/Earth.png"/>
                </Paragraph>
            </RichTextBox>

            <local:ViewSourceButton Grid.Row="2" Background="#FF716AD1">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="RichTextBox_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/RichTextBox"/>
                    <local:ViewSourceButtonInfo FileName="RichTextBox_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/RichTextBox"/>
                    <local:ViewSourceButtonInfo FileName="RichTextBox_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/RichTextBox"/>
                    <local:ViewSourceButtonInfo FileName="RichTextBox_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/RichTextBox"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
