<UserControl x:Class="OpenSilver.Showcase.NumericUpDown_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Showcase">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/NumericUpDownStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ContentControl Width="200" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Background="#75B595"
                            Content="NumericUpDown"
                            Foreground="#FF3ADE8F"
                            Style="{StaticResource HeaderControl_Style}"/>

            <NumericUpDown Grid.Row="1"
                           Width="130"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           DecimalPlaces="{Binding Value, ElementName=DecimalPlacesUpDown}"
                           Increment="{Binding Value, ElementName=IncrementUpDown}"
                           Maximum="100"
                           Minimum="0"/>

            <StackPanel Grid.Row="2"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center">
                <TextBlock Margin="0,0,0,5"
                           FontSize="12"
                           FontWeight="Bold"
                           Text="Custom Style"/>
                <NumericUpDown DecimalPlaces="{Binding Value, ElementName=DecimalPlacesUpDown}"
                               FontSize="14"
                               Increment="{Binding Value, ElementName=IncrementUpDown}"
                               Style="{StaticResource PlusMinusNumericUpDownStyle}"/>
            </StackPanel>

            <Expander Grid.Row="3"
                      Margin="10,10,0,0"
                      Style="{StaticResource PopupExpanderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Margin="0,0,2,0" Content="DecimalPlaces"/>
                    <NumericUpDown Name="DecimalPlacesUpDown"
                                   Grid.Column="1"
                                   MinWidth="0"
                                   FontSize="12"/>

                    <Label Grid.Row="2" Content="Increment"/>
                    <NumericUpDown Name="IncrementUpDown"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   MinWidth="0"
                                   FontSize="12"
                                   Minimum="1"/>
                </Grid>
            </Expander>

            <local:ViewSourceButton Grid.Row="4" Background="#FF3ADE8F">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="NumericUpDown_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/NumericUpDown"/>
                    <local:ViewSourceButtonInfo FileName="NumericUpDown_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/NumericUpDown"/>
                    <local:ViewSourceButtonInfo FileName="NumericUpDown_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/NumericUpDown"/>
                    <local:ViewSourceButtonInfo FileName="NumericUpDown_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/NumericUpDown"/>
                    <local:ViewSourceButtonInfo FileName="NumericUpDownStyles.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/NumericUpDown/Styles"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
