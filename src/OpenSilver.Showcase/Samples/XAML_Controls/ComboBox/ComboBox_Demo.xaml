<UserControl
    x:Class="OpenSilver.Showcase.ComboBox_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}" Width="210">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="ComboBox" Foreground="#FFFF657F" Background="#FFCB8591" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ComboBox x:Name="ComboBox1" DisplayMemberPath="Name" SelectedValuePath="ImagePath" VerticalAlignment="Top"/>
                <Image Source="{Binding ElementName=ComboBox1, Path=SelectedValue}" Width="60" Height="60" Margin="20,0,0,0"/>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2"
                                    Background="#FFFF657F">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/ComboBox"
                                                FileName="ComboBox_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/ComboBox"
                                                FileName="ComboBox_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/ComboBox"
                                                FileName="ComboBox_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/ComboBox"
                                                FileName="ComboBox_Demo.xaml.fs" />
                    <shared:ViewStyleSourceInfo TabHeader="Default ComboBox Style" Fragment="#L1975-L2391" />
                    <shared:ViewModernStyleSourceInfo TabHeader="Modern ComboBox Style" Fragment="#L2610-L2913"/>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Other"
                                                FileName="Planet.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Other"
                                                FileName="Planet.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Other"
                                                FileName="Planet.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
