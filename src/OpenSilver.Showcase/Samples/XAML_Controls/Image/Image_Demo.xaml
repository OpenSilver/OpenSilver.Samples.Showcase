<UserControl x:Class="OpenSilver.Showcase.Image_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Width="210" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="Image"
                            Foreground="#FF8D73FF"
                            Style="{StaticResource HeaderControl_Style}"/>

            <Image Name="image"
                   Grid.Row="1"
                   Width="100"
                   Height="100"
                   HorizontalAlignment="Center"
                   Source="ms-appx:/Other/Logo.png"
                   Stretch="None"/>

            <StackPanel Grid.Row="2"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Stretch "/>
                <ComboBox ItemsSource="{Binding Converter={StaticResource EnumToListConverter}, ConverterParameter={x:Static Image.StretchProperty}}" SelectedItem="{Binding ElementName=image, Path=Stretch, Mode=TwoWay}"/>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="3" Background="#FF8D73FF">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="Image_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Image"/>
                    <local:ViewSourceButtonInfo FileName="Image_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Image"/>
                    <local:ViewSourceButtonInfo FileName="Image_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Image"/>
                    <local:ViewSourceButtonInfo FileName="Image_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Image"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
