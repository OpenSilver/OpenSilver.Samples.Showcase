<UserControl x:Class="OpenSilver.Showcase.Thumb_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Width="210" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Background="#FF8CC09C"
                            Content="Thumb"
                            Foreground="#FF61DD8A"
                            Style="{StaticResource HeaderControl_Style}"/>

            <Thumb Grid.Row="1"
                   Width="50"
                   Height="30"
                   DragCompleted="OnThumbDragCompleted"
                   DragDelta="OnThumbDragDelta"
                   DragStarted="OnThumbDragStarted"/>

            <TextBlock Name="infoTextBlock"
                       Grid.Row="2"
                       Margin="0,20"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Text="Drag the thumb"
                       TextWrapping="Wrap"/>

            <shared:ViewSourceButton Grid.Row="3" Background="#FF61DD8A">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo FileName="Thumb_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Thumb"/>
                    <shared:ViewSourceButtonInfo FileName="Thumb_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Thumb"/>
                    <shared:ViewSourceButtonInfo FileName="Thumb_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Thumb"/>
                    <shared:ViewSourceButtonInfo FileName="Thumb_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Controls/Thumb"/>
                    <shared:ViewStyleSourceInfo TabHeader="Default Thumb Style" Fragment="#L3819-L3961"/>
                    <shared:ViewModernStyleSourceInfo TabHeader="Modern Thumb Style" Fragment="#L3492-L3581"/>
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
