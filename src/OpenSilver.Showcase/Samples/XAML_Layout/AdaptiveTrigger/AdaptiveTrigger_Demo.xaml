<UserControl
    x:Class="OpenSilver.Showcase.AdaptiveTrigger_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Style="{StaticResource Card_Style}" Width="245">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    
                    <VisualState x:Name="LargeVisualState">
                        <VisualState.StateTriggers>
                            <!--VisualState to be triggered when window width is >=720 effective pixels.-->
                            <AdaptiveTrigger MinWindowWidth="720"/>
                        </VisualState.StateTriggers>

                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SizeTextBlock"
               Storyboard.TargetProperty="Foreground">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Red"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SizeTextBlock"
           Storyboard.TargetProperty="Text">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="larger"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Adaptive triggers" Foreground="#FFC7C228" Background="#FFC5B58B" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <TextBlock Text="The AdaptiveTrigger lets you define a storyboard to apply when the window is above a certain size." TextWrapping="Wrap" Margin="2"/>
                <TextBlock  TextWrapping="Wrap" Margin="2,3">
                <Run Text="The window is "/>
                <Run x:Name="SizeTextBlock" Text="smaller" FontWeight="Bold"/>
                <Run Text=" than 720 pixels."/>
                </TextBlock>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2" Background="#FFC7C228">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/AdaptiveTrigger"
                                        FileName="AdaptiveTrigger_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/AdaptiveTrigger"
                                        FileName="AdaptiveTrigger_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/AdaptiveTrigger"
                                        FileName="AdaptiveTrigger_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/AdaptiveTrigger"
                                        FileName="AdaptiveTrigger_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
