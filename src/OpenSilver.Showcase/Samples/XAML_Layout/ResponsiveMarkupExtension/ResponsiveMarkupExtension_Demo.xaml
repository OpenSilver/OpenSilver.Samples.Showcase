<UserControl
    x:Class="OpenSilver.Showcase.ResponsiveMarkupExtension_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Style="{StaticResource Card_Style}" Width="245">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Responsive Markup Extension" Foreground="#FFC7C228" Background="#FFC5B58B" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <TextBlock Text="The ResponsiveMarkupExtension lets you define multiple values to apply on a property, based on the Window's size." TextWrapping="Wrap" Margin="2"/>
                <TextBlock TextWrapping="Wrap" Margin="2,3">
                    <Run Text="Current value without defining any threshold: "/>
                    <Run Text="{Responsive Mobile=Mobile, Tablet=Tablet, Desktop=Desktop}" Foreground="{Responsive Mobile=#FF00FA9A, Tablet=MediumPurple, Desktop=SandyBrown}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="2,3">
                    <Run Text="Current value with threshold set to 1000: "/>
                    <Run Text="{Responsive Mobile=Mobile, Tablet=Tablet, Desktop=Desktop, Threshold=1500}" Foreground="{Responsive Mobile=#FF00FA9A, Tablet=MediumPurple, Desktop=SandyBrown, Threshold=1500}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="2,3">
                    <Run Text="Current value with threshold set to 700 2000: "/>
                    <Run Text="{Responsive Mobile=Mobile, Tablet=Tablet, Desktop=Desktop, Threshold=700 2000}" Foreground="{Responsive Mobile=#FF00FA9A, Tablet=MediumPurple, Desktop=SandyBrown, Threshold=700 2000}"/>
                </TextBlock>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2" Background="#FFC7C228">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ResponsiveMarkupExtension"
                                            FileName="ResponsiveMarkupExtension_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ResponsiveMarkupExtension"
                                            FileName="ResponsiveMarkupExtension_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ResponsiveMarkupExtension"
                                            FileName="ResponsiveMarkupExtension_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ResponsiveMarkupExtension"
                                            FileName="ResponsiveMarkupExtension_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
