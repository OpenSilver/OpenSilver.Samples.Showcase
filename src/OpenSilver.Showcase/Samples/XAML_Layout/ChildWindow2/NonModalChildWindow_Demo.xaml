<UserControl
    x:Class="OpenSilver.Showcase.NonModalChildWindow_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}" Width="255">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Non-Modal ChildWindow" Foreground="#FFFF7065" Background="#FFD5928F" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Show Modal ChildWindow" Click="ButtonTestChildWindow_Modal_Click" Margin="0,5"/>
                <Button Content="Show Non-Modal ChildWindow" Click="ButtonTestChildWindow_NonModal_Click"/>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2" Background="#FFFF7065">                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow2"
                                                FileName="NonModalChildWindow_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow2"
                                                FileName="NonModalChildWindow_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow2"
                                                FileName="NonModalChildWindow_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow2"
                                                FileName="NonModalChildWindow_Demo.xaml.fs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow2"
                                                FileName="SmallChildWindow.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow2"
                                                FileName="SmallChildWindow.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow2"
                                                FileName="SmallChildWindow.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow2"
                                                FileName="SmallChildWindow.xaml.fs" />
                    <shared:ViewStyleSourceInfo TabHeader="Default ChildWindow Style" Fragment="#L4254-L4681"/>
                    <shared:ViewModernStyleSourceInfo TabHeader="Modern ChildWindow Style" Fragment="#L2917-L3162"/>
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
