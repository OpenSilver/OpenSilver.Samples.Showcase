<UserControl
    x:Class="OpenSilver.Showcase.GridSplitter_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}" Width="200">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="GridSplitter" Foreground="#BF6CEE" Background="#FFB390CA" Style="{StaticResource HeaderControl_Style}"/>
            <Grid Grid.Row="1" Width="150" Height="100" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="50" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#FFEE6CED" CornerRadius="2" Margin="2">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="White">Left side</TextBlock>
                </Border>
                <GridSplitter Grid.Column="1" Name="gridSplitter" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <Border Grid.Column="2" Background="#FF9A6CEE" CornerRadius="2" Margin="2">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="White">Right side</TextBlock>
                </Border>
            </Grid>
            <CheckBox Grid.Row="2" Content="ShowsPreview" IsChecked="{Binding ShowsPreview, ElementName=gridSplitter, Mode=TwoWay}" FontSize="12" Margin="18,0,0,0"/>
            <shared:ViewSourceButton Grid.Row="3" Background="#BF6CEE">                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/GridSplitter"
                                                FileName="GridSplitter_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/GridSplitter"
                                                FileName="GridSplitter_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/GridSplitter"
                                                FileName="GridSplitter_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/GridSplitter"
                                                FileName="GridSplitter_Demo.xaml.fs" />
                    <shared:ViewStyleSourceInfo TabHeader="GridSplitter Style" RelativePath="src/Runtime/Controls/Themes" Fragment="#L474-L604" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
