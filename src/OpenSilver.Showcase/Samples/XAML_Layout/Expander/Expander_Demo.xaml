<UserControl x:Class="OpenSilver.Showcase.Expander_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Width="245"
                    Height="340"
                    Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Background="#FFCCA376"
                            Content="Expander"
                            Foreground="#FCAB54"
                            Style="{StaticResource HeaderControl_Style}"/>

            <Expander Name="expander"
                      Grid.Row="1"
                      Margin="0,30,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Header="Click to Expand/Collapse">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock MaxWidth="120"
                                   Text="{Binding}"
                                   TextWrapping="Wrap"/>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <TextBlock Text="This is the content of the Expander"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Expander>

            <StackPanel Grid.Row="2" Margin="10">
                <CheckBox Content="IsExpanded"
                          FontSize="12"
                          IsChecked="{Binding IsExpanded, ElementName=expander, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Text="ExpandDirection"/>
                    <ComboBox Height="24"
                              Margin="2,1"
                              FontSize="12"
                              ItemsSource="{Binding Converter={StaticResource EnumToListConverter}, ConverterParameter={x:Static Expander.ExpandDirectionProperty}}"
                              SelectedValue="{Binding ExpandDirection, ElementName=expander, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="3" Background="#FCAB54">                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="Expander_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Expander"/>
                    <local:ViewSourceButtonInfo FileName="Expander_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Expander"/>
                    <local:ViewSourceButtonInfo FileName="Expander_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Expander"/>
                    <local:ViewSourceButtonInfo FileName="Expander_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Expander"/>
                    <local:ViewStyleSourceInfo TabHeader="Default Expander Style" RelativePath="src/Runtime/Controls.Toolkit/Themes" Fragment="#L443-L1238"/>
                    <local:ViewModernStyleSourceInfo TabHeader="Modern Expander Style" FileName="OpenSilver.Controls.Toolkit.xaml" Fragment="#L255-L937"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
