<UserControl
    x:Class="OpenSilver.Showcase.ChildWindow_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenSilver.Showcase">
    <ContentControl Style="{StaticResource Card_Style}" Width="220">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="ChildWindow" Foreground="#FFFF7065" Background="#FFD5928F" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Show Login ChildWindow" Click="ButtonTestChildWindow_Click"/>
                <TextBlock Margin="0,10,0,0" TextAlignment="Center" Name="TextBlockForTestingChildWindow" Text="" />
            </StackPanel>
            <local:ViewSourceButton Grid.Row="2" Background="#FFFF7065">                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow"
                                                FileName="ChildWindow_Demo.xaml" />
                    <local:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow"
                                                FileName="ChildWindow_Demo.xaml.cs" />
                    <local:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow"
                                                FileName="ChildWindow_Demo.xaml.vb" />
                    <local:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow"
                                                FileName="ChildWindow_Demo.xaml.fs" />
                    <local:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow"
                                                FileName="LoginWindow.xaml" />
                    <local:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow"
                                                FileName="LoginWindow.xaml.cs" />
                    <local:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow"
                                                FileName="LoginWindow.xaml.vb" />
                    <local:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/ChildWindow"
                                                FileName="LoginWindow.xaml.fs" />
                    <local:ViewStyleSourceInfo TabHeader="Default ChildWindow Style" Fragment="#L4267-L4696"/>
                    <local:ViewModernStyleSourceInfo TabHeader="Modern ChildWindow Style" Fragment="#L2883-L3128"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
