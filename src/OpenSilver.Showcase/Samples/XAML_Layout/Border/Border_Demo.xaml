<UserControl
    x:Class="OpenSilver.Showcase.Border_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}" Width="200">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Border" Foreground="#FF73AFB3" Background="#FF91C3C5" Style="{StaticResource HeaderControl_Style}"/>
            <Border Grid.Row="1" CornerRadius="10" Padding="16" Background="#FF73AFB3" HorizontalAlignment="Center" BorderBrush="#FFB57979" BorderThickness="3">
                <TextBlock Text="Unlike a Rectangle, a Border can contain a child element (such as this text)." Foreground="White" FontSize="12" Width="120" TextWrapping="Wrap"/>
            </Border>
            <shared:ViewSourceButton Grid.Row="2"
                                    Background="#FF13D7E3">                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Border"
                                                FileName="Border_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Border"
                                                FileName="Border_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Border"
                                                FileName="Border_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Border"
                                                FileName="Border_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
