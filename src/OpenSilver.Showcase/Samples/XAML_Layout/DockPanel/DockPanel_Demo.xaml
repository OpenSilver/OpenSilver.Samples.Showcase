<UserControl x:Class="OpenSilver.Showcase.DockPanel_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Width="200" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Background="#FFBA8AC6"
                            Content="DockPanel"
                            Foreground="#FFD66DED"
                            Style="{StaticResource HeaderControl_Style}"/>

            <DockPanel Name="dockPanel"
                       Grid.Row="1"
                       Width="170"
                       Height="120"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Background="#DDDDDD">
                <Border Width="50"
                        Margin="2"
                        Background="#FF6666ff"
                        CornerRadius="2"
                        DockPanel.Dock="Left">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Left"/>
                </Border>
                <Border Height="20"
                        Margin="2"
                        Background="#ffff4d4d"
                        CornerRadius="2"
                        DockPanel.Dock="Top">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Top"/>
                </Border>
                <Border Width="40"
                        Margin="2"
                        Background="#FF61C461"
                        CornerRadius="2"
                        DockPanel.Dock="Right">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Right"/>
                </Border>
                <Border Height="20"
                        Margin="2"
                        Background="#FFCF9641"
                        CornerRadius="2"
                        DockPanel.Dock="Bottom">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Bottom"/>
                </Border>
                <Border Margin="2"
                        Background="#FFD66DED"
                        CornerRadius="2"
                        DockPanel.Dock="Left">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Left"/>
                </Border>
                <Border Margin="2"
                        Background="#FFD46477"
                        CornerRadius="2"
                        DockPanel.Dock="Top">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Last Child"
                               TextWrapping="Wrap"/>
                </Border>
            </DockPanel>

            <CheckBox Grid.Row="2"
                      Margin="10"
                      VerticalAlignment="Top"
                      Content="LastChildFill"
                      FontSize="12"
                      IsChecked="{Binding LastChildFill, ElementName=dockPanel, Mode=TwoWay}"/>

            <local:ViewSourceButton Grid.Row="3" Background="#FFD66DED">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="DockPanel_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/DockPanel"/>
                    <local:ViewSourceButtonInfo FileName="DockPanel_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/DockPanel"/>
                    <local:ViewSourceButtonInfo FileName="DockPanel_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/DockPanel"/>
                    <local:ViewSourceButtonInfo FileName="DockPanel_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/DockPanel"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>

