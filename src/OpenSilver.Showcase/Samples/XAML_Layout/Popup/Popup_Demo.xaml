<UserControl x:Class="OpenSilver.Showcase.Popup_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Width="210" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="Popup"
                            Foreground="#FF3393FF"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Name="openPopupButton"
                        Click="OpenPopupButton_Click"
                        Content="Open popup"/>

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Placement "/>
                    <ComboBox Grid.Column="1"
                              Height="24"
                              FontSize="12"
                              ItemsSource="{Binding Converter={StaticResource EnumToListConverter}, ConverterParameter={x:Static Popup.PlacementProperty}}"
                              SelectedItem="{Binding ElementName=MyPopup, Path=Placement, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="HorizontalOffset "/>
                    <NumericUpDown Grid.Row="1"
                                   Grid.Column="1"
                                   Height="24"
                                   MinWidth="0"
                                   Margin="0,10"
                                   FontSize="12"
                                   Maximum="3000"
                                   Minimum="-100"
                                   Value="{Binding ElementName=MyPopup, Path=HorizontalOffset, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center"
                               Text="VerticalOffset "/>
                    <NumericUpDown Grid.Row="2"
                                   Grid.Column="1"
                                   Height="24"
                                   MinWidth="0"
                                   FontSize="12"
                                   Maximum="3000"
                                   Minimum="-1000"
                                   Value="{Binding ElementName=MyPopup, Path=VerticalOffset, Mode=TwoWay}"/>

                    <CheckBox Grid.Row="3"
                              Grid.ColumnSpan="2"
                              Margin="0,10,0,0"
                              Content="StaysWithinScreenBounds"
                              FontSize="11"
                              IsChecked="{Binding StaysWithinScreenBounds, ElementName=MyPopup, Mode=TwoWay}"/>
                </Grid>

                <Popup x:Name="MyPopup" PlacementTarget="{Binding ElementName=openPopupButton}">
                    <Border Background="{DynamicResource Theme_BackgroundBrush}"
                            BorderBrush="{DynamicResource Theme_BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Margin="20" Text="This is a popup!"/>
                            <Button Grid.Row="1"
                                    Margin="5"
                                    Padding="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="PopupButtonClose_Click"
                                    Content="Close"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2" Background="#FF3393FF">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="Popup_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Popup"/>
                    <local:ViewSourceButtonInfo FileName="Popup_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Popup"/>
                    <local:ViewSourceButtonInfo FileName="Popup_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Popup"/>
                    <local:ViewSourceButtonInfo FileName="Popup_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Layout/Popup"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
