<UserControl
    x:Class="OpenSilver.Showcase.JSONP_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}" Width="245">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="JSONP" Foreground="#FFBF6CEE" Background="#FFB390CA" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Orientation="Vertical" Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="You can use JSONP to circumvent cross-domain policies. More information and sample code can be found at:" Foreground="#FF808080" TextWrapping="Wrap" FontSize="12" HorizontalAlignment="Left"/>
                <HyperlinkButton Foreground="#FFBF6CEE" Margin="0,10,0,0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" NavigateUri="https://doc.opensilver.net/documentation/in-depth-topics/jsonp.html" TargetName="_blank">
                    <TextBlock Cursor="Hand" TextWrapping="Wrap" Text="https://doc.opensilver.net/documentation/in-depth-topics/jsonp.html"/>
                </HyperlinkButton>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2"
                                    Background="#FFBF6CEE">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Client_Server/JSONP"
                                                FileName="JSONP_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Client_Server/JSONP"
                                                FileName="JSONP_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Client_Server/JSONP"
                                                FileName="JSONP_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Client_Server/JSONP"
                                                FileName="JSONP_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
