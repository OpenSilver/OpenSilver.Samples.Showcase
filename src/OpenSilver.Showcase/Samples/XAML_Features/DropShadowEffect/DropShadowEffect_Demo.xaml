<UserControl x:Class="OpenSilver.Showcase.DropShadowEffect_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="DropShadowEffect"
                            Foreground="#ff70db70"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="ShadowedText"
                           Width="220"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap">
                    This text has some shadows<LineBreak/>
                    applied on it.
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          Opacity="0.3"
                                          ShadowDepth="3"
                                          Color="{DynamicResource Theme_TextColor}"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Rectangle x:Name="ShadowedRectangle"
                           Grid.Row="1"
                           Width="40"
                           Height="40"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Fill="White">
                    <Rectangle.Effect>
                        <DropShadowEffect x:Name="RectangleShadow"
                                          BlurRadius="10"
                                          Direction="320"
                                          Opacity="0.3"
                                          ShadowDepth="3"
                                          Color="{DynamicResource Theme_TextColor}"/>
                    </Rectangle.Effect>
                </Rectangle>

                <!--  Controls for modifying the rectangle shadow  -->
                <Border Margin="0,15,0,0"
                        Padding="5"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="NumericUpDown">
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Margin" Value="5"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--  Shadow Depth Control  -->
                        <TextBlock Margin="0,0,5,0"
                                   VerticalAlignment="Center"
                                   Text="ShadowDepth"/>
                        <NumericUpDown Grid.Column="1"
                                       Maximum="300"
                                       Value="{Binding ElementName=RectangleShadow, Path=ShadowDepth, Mode=TwoWay}"/>

                        <!--  Blur Radius Control  -->
                        <TextBlock Grid.Row="1"
                                   VerticalAlignment="Center"
                                   Text="BlurRadius"/>
                        <NumericUpDown Grid.Row="1"
                                       Grid.Column="1"
                                       Value="{Binding ElementName=RectangleShadow, Path=BlurRadius, Mode=TwoWay}"/>

                        <!--  Opacity Control  -->
                        <TextBlock Grid.Row="2"
                                   VerticalAlignment="Center"
                                   Text="Opacity"/>
                        <NumericUpDown Grid.Row="2"
                                       Grid.Column="1"
                                       DecimalPlaces="2"
                                       Increment="0.1"
                                       Maximum="1"
                                       Minimum="0"
                                       Value="{Binding ElementName=RectangleShadow, Path=Opacity, Mode=TwoWay}"/>

                        <!--  Direction  -->
                        <TextBlock Grid.Row="3"
                                   VerticalAlignment="Center"
                                   Text="Direction"/>
                        <NumericUpDown Grid.Row="3"
                                       Grid.Column="1"
                                       Increment="0.1"
                                       Maximum="360"
                                       Minimum="0"
                                       Value="{Binding ElementName=RectangleShadow, Path=Direction, Mode=TwoWay}"/>

                        <!--  Color Selection  -->
                        <TextBlock Grid.Row="4"
                                   VerticalAlignment="Center"
                                   Text="Color"/>
                        <local:HtmlColorPicker Name="ColorPicker"
                                               Grid.Row="4"
                                               Grid.Column="1"
                                               Margin="0,5"
                                               HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2" Background="#ff70db70">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="DropShadowEffect_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/DropShadowEffect"/>
                    <local:ViewSourceButtonInfo FileName="DropShadowEffect_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/DropShadowEffect"/>
                    <local:ViewSourceButtonInfo FileName="DropShadowEffect_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/DropShadowEffect"/>
                    <local:ViewSourceButtonInfo FileName="DropShadowEffect_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/DropShadowEffect"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
