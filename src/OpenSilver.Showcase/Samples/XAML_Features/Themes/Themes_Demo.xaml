<UserControl x:Class="OpenSilver.Showcase.Themes_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Width="200" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="Themes"
                            Foreground="#FFD46141"
                            Style="{StaticResource HeaderControl_Style}"/>

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,15"
                       FontSize="14"
                       TextAlignment="Center"
                       TextWrapping="Wrap">
                This app uses a modern theme. You can switch between light and dark mode by clicking the toggle in the bottom-left corner.<LineBreak/><LineBreak/>
                Learn more <Hyperlink NavigateUri="https://doc.opensilver.net/documentation/how-to-topics/theme-handling.html" TargetName="_blank">here</Hyperlink>.
            </TextBlock>

            <StackPanel Grid.Row="2">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>
                <Border Background="{DynamicResource Theme_PrimaryBrush}">
                    <TextBlock Text="PrimaryBrush"/>
                </Border>
                <Border Background="{DynamicResource Theme_BackgroundBrush}">
                    <TextBlock Text="BackgroundBrush"/>
                </Border>
                <Border Background="{DynamicResource Theme_BorderBrush}">
                    <TextBlock Text="BorderBrush"/>
                </Border>
                <Border Background="{DynamicResource Theme_ErrorBrush}">
                    <TextBlock Text="ErrorBrush"/>
                </Border>
                <Border Background="{DynamicResource Theme_TextBrush}">
                    <TextBlock Foreground="{DynamicResource Theme_TextOnPrimaryBrush}" Text="TextBrush"/>
                </Border>
            </StackPanel>

            <shared:ViewSourceButton Grid.Row="3" Background="#FFD46141">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo FileName="Themes_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Themes"/>
                    <shared:ViewSourceButtonInfo FileName="App.xaml" RelativePath="src\OpenSilver.Showcase"/>
                    <shared:ViewSourceButtonInfo FileName="MainPage.xaml" RelativePath="src\OpenSilver.Showcase"/>
                    <shared:ViewSourceButtonInfo FileName="MainPage.xaml.cs" RelativePath="src\OpenSilver.Showcase"/>
                    <shared:ViewSourceButtonInfo FileName="MainPage.xaml.vb" RelativePath="src\OpenSilver.Showcase"/>
                    <shared:ViewSourceButtonInfo FileName="MainPage.xaml.fs" RelativePath="src\OpenSilver.Showcase"/>
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
