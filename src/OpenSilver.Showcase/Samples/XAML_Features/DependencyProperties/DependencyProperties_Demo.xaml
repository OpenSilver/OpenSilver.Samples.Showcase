<UserControl
    x:Class="OpenSilver.Showcase.DependencyProperties_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared"
    x:Name="UserControlAccess">
    <ContentControl Style="{StaticResource Card_Style}" Width="245">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Dependency Properties" Foreground="#FFFFCC33" Background="#FFC5B58B" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <TextBlock xml:space="preserve" Text=" A dependency property enables animations, style, binding, etc. 
                           Use the &quot;propdp&quot; code snippet to facilitate the creation of a dependecy property"  Foreground="#FF808080" TextWrapping="Wrap" FontSize="12" HorizontalAlignment="Left"/>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="--" Width="40" Click="Decrementation_Click" VerticalContentAlignment="Center" Margin="0,0,5,0" />
                    <Button Content="{Binding MySampleDependencyProperty, ElementName=UserControlAccess}" Width="40" VerticalContentAlignment="Center" Margin="0,0,5,0" />
                    <Button Content="++" Width="40" Click="Incrementation_Click"  VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2" Background="#FFFFCC33">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/DependencyProperties"
                                                FileName="DependencyProperties_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/DependencyProperties"
                                                FileName="DependencyProperties_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/DependencyProperties"
                                                FileName="DependencyProperties_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/DependencyProperties"
                                                FileName="DependencyProperties_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
