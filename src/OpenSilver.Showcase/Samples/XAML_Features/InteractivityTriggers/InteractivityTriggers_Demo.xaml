<UserControl x:Class="OpenSilver.Showcase.InteractivityTriggers_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}"
                    Width="245">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="Interactivity Triggers"
                            Foreground="#FFF78069"
                            Background="#FFDCA59C"
                            Style="{StaticResource HeaderControl_Style}" />
            <StackPanel Grid.Row="1"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="TestButton"
                        Content="Click me"
                        Width="100"
                        Height="30">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:InvokeCommandAction Command="{Binding Path=TestCommand, Mode=OneWay}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2"
                                    Background="#FFF78069">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/InteractivityTriggers"
                                                FileName="InteractivityTriggers_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/InteractivityTriggers"
                                                FileName="InteractivityTriggers_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/InteractivityTriggers"
                                                FileName="InteractivityTriggers_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/InteractivityTriggers"
                                                FileName="InteractivityTriggers_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
