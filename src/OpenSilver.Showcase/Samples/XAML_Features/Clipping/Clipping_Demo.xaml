<UserControl x:Class="OpenSilver.Showcase.Clipping_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="Clipping"
                            Foreground="#FF69B4"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <TextBlock Margin="5"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Text="Demonstrates the use of UIElement.Clip to clip content."
                           TextWrapping="Wrap"/>
                <Button Name="button"
                        Width="140"
                        Height="60"
                        Margin="0,10"
                        BorderBrush="#FF676767"
                        BorderThickness="2"
                        Content="Button">
                    <Button.Clip>
                        <EllipseGeometry Center="70,30"
                                         RadiusX="70"
                                         RadiusY="30"/>
                    </Button.Clip>
                    <Button.Background>
                        <SolidColorBrush Color="#FF69B4"/>
                    </Button.Background>
                </Button>
                <CheckBox Name="clipCheckBox"
                          Content="Clip"
                          IsChecked="True"/>
            </StackPanel>

            <shared:ViewSourceButton Grid.Row="2" Background="#FF69B4">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo FileName="Clipping_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Clipping"/>
                    <shared:ViewSourceButtonInfo FileName="Clipping_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Clipping"/>
                    <shared:ViewSourceButtonInfo FileName="Clipping_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Clipping"/>
                    <shared:ViewSourceButtonInfo FileName="Clipping_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Clipping"/>
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
