<UserControl x:Class="OpenSilver.Showcase.TransformToVisual_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Background="#FFA1C3D7"
                            Content="TransformToVisual"
                            Foreground="#FF33B4FF"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1" Margin="0,20">
                <TextBlock FontSize="12"
                           Text="Top-left corner of this demo relative to MainWindow:"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Name="resultTextBlock"
                           Margin="0,10,0,0"
                           FontSize="14"
                           FontWeight="Bold"
                           TextAlignment="Center"/>
            </StackPanel>

            <shared:ViewSourceButton Grid.Row="2" Background="#FF33B4FF">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo FileName="TransformToVisual_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/TransformToVisual"/>
                    <shared:ViewSourceButtonInfo FileName="TransformToVisual_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/TransformToVisual"/>
                    <shared:ViewSourceButtonInfo FileName="TransformToVisual_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/TransformToVisual"/>
                    <shared:ViewSourceButtonInfo FileName="TransformToVisual_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/TransformToVisual"/>
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
