<UserControl
    x:Class="OpenSilver.Showcase.XAML_Resource_Dictionary_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Dictionaries/Style1.xaml"/>
                <ResourceDictionary Source="Dictionaries/Style2.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
  
    <ContentControl Style="{StaticResource Card_Style}" Width="245">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="ResourceDictionary" Foreground="#FF6F7DFF" Background="#FF9A9FCE" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <Button Style="{StaticResource ButtonStyle1}" Margin="5">
                    <TextBlock Text="Button using ButtonStyle1 from Style1.xaml" TextWrapping="Wrap"/>
                </Button>
                <Button Style="{StaticResource ButtonStyle2}" Margin="5">
                    <TextBlock Text="Button using ButtonStyle2 from Style2.xaml" TextWrapping="Wrap"/>
                </Button>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2"
                                    Background="#FF6F7DFF">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/XAML_Resource_Dictionary"
                                                FileName="XAML_Resource_Dictionary_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/XAML_Resource_Dictionary"
                                                FileName="XAML_Resource_Dictionary_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/XAML_Resource_Dictionary"
                                                FileName="XAML_Resource_Dictionary_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/XAML_Resource_Dictionary"
                                                FileName="XAML_Resource_Dictionary_Demo.xaml.fs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/XAML_Resource_Dictionary/Dictionaries"
                                                FileName="Style1.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/XAML_Resource_Dictionary/Dictionaries"
                                                FileName="Style2.xaml" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
