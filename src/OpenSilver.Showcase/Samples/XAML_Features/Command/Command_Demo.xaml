<UserControl x:Class="OpenSilver.Showcase.Command_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Background="#FFDCA59C"
                            Content="Command"
                            Foreground="#FFF78069"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.DataContext>
                    <local:CommandDemoViewModel xmlns:local="clr-namespace:OpenSilver.Showcase"/>
                </StackPanel.DataContext>

                <Button Command="{Binding ShowMessageCommand}"
                        CommandParameter="{Binding Message}"
                        Content="Test command"/>
                <TextBox Margin="0,10,0,0" Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <shared:ViewSourceButton Grid.Row="2" Background="#FFF78069">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo FileName="Command_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Command"/>
                    <shared:ViewSourceButtonInfo FileName="CommandDemoViewModel.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Command"/>
                    <shared:ViewSourceButtonInfo FileName="CommandDemoViewModel.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Command"/>
                    <shared:ViewSourceButtonInfo FileName="CommandDemoViewModel.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Command"/>
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
