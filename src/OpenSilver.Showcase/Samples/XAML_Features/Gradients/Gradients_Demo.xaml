<UserControl
    x:Class="OpenSilver.Showcase.Gradients_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}" Width="245">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Gradients" Foreground="#FF70B36B" Background="#FFA9D4A4" Style="{StaticResource HeaderControl_Style}"/>
          <StackPanel Grid.Row="1">
            <Border Height="70" Width="120" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border.Background>
                <LinearGradientBrush EndPoint="0.931,1.069" StartPoint="0.117,-0.271">
                  <GradientStop Color="Red" Offset="0"/>
                  <GradientStop Color="#FFFFF800" Offset="0.175"/>
                  <GradientStop Color="#FF43FF00" Offset="0.35"/>
                  <GradientStop Color="#FF03FFDD" Offset="0.525"/>
                  <GradientStop Color="#FF003AFF" Offset="0.7"/>
                  <GradientStop Color="#FFE600FF" Offset="0.875"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <Ellipse Height="100" Width="100" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="Red" Offset="0"/>
                  <GradientStop Color="#FFFFF800" Offset="0.175"/>
                  <GradientStop Color="#FF43FF00" Offset="0.35"/>
                  <GradientStop Color="#FF03FFDD" Offset="0.525"/>
                  <GradientStop Color="#FF003AFF" Offset="0.7"/>
                  <GradientStop Color="#FFE600FF" Offset="0.875"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
          </StackPanel>
            <shared:ViewSourceButton Grid.Row="2"
                                    Background="#FF70B36B">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Gradients"
                                                FileName="Gradients_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Gradients"
                                                FileName="Gradients_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Gradients"
                                                FileName="Gradients_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Gradients"
                                                FileName="Gradients_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
