<UserControl x:Class="OpenSilver.Showcase.Cursor_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="Cursor"
                            Foreground="#FF4CAF50"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="20,2"/>
                        <Setter Property="Background" Value="#FF4CAF50"/>
                        <Setter Property="Content" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Cursor}"/>
                    </Style>
                </StackPanel.Resources>

                <TextBlock Margin="5"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Text="Hover over the buttons below to see different mouse cursors."
                           TextWrapping="Wrap"/>

                <Button Cursor="Arrow"/>
                <Button Cursor="Hand"/>
                <Button Cursor="Wait"/>
                <Button Cursor="AppStarting"/>
                <Button Cursor="Cross"/>
                <Button Cursor="Help"/>
                <Button Cursor="IBeam"/>
                <Button Cursor="No"/>
                <Button Cursor="None"/>
                <Button Cursor="ScrollAll"/>
                <Button Cursor="SizeAll"/>
                <Button Cursor="SizeNS"/>
                <Button Cursor="SizeWE"/>
                <Button Cursor="SizeNESW"/>
                <Button Cursor="SizeNWSE"/>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2" Background="#FF4CAF50">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="Cursor_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Cursor"/>
                    <local:ViewSourceButtonInfo FileName="Cursor_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Cursor"/>
                    <local:ViewSourceButtonInfo FileName="Cursor_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Cursor"/>
                    <local:ViewSourceButtonInfo FileName="Cursor_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/XAML_Features/Cursor"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
