<UserControl
    x:Class="OpenSilver.Showcase.Barometer_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Style="{StaticResource Card_Style}" Width="200">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Barometer Status" Foreground="#bde567" Background="#FF92BEAC" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel x:Name="SampleContainer" Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ToggleButton Content="Barometer on/off" Click="BarometerToggleButton_Click" Height="32" Foreground="#bde567" Background="{DynamicResource NativeApiButtonBackground}" FontWeight="Bold"/>
                <TextBlock x:Name="BarometerTextBlock" TextWrapping="Wrap"/>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2"
                 Background="#bde567">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Maui_Hybrid/Barometer"
                             FileName="Barometer_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Maui_Hybrid/Barometer"
                             FileName="Barometer_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Maui_Hybrid/Barometer"
                             FileName="Barometer_Demo.xaml.vb" />
                    <shared:ViewSourceButtonInfo RelativePath="src/OpenSilver.Showcase/Samples/Maui_Hybrid/Barometer"
                             FileName="Barometer_Demo.xaml.fs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
