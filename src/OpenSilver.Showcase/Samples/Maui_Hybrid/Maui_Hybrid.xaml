<Page
    x:Class="OpenSilver.Showcase.Maui_Hybrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
    xmlns:local="clr-namespace:OpenSilver.Showcase"
    Style="{StaticResource Page_Style}"
    Title="Native APIs">
    <StackPanel>

        <StackPanel>
            <ContentControl Content="Native APIs (Web or MAUI Hybrid)" Style="{StaticResource PageTitle_Style}"/>
            <TextBlock Style="{StaticResource PageIntroText_Style}">While OpenSilver is web-first, you can also publish apps as native iOS, Android, Windows,
                                                                    Mac, or Linux applications using <Hyperlink NavigateUri="https://doc.opensilver.net/documentation/general/maui-hybrid-launcher.html" TargetName="_blank" Foreground="{DynamicResource Theme_TextBrush}">.NET MAUI-OpenSilver Hybrid</Hyperlink>.
                                                                    You can see an example of Android or iOS app by downloading this app from <Hyperlink NavigateUri="https://play.google.com/store/apps/details?id=net.opensilver.showcase" TargetName="_blank" Foreground="{DynamicResource Theme_TextBrush}">Google Play</Hyperlink> or <Hyperlink NavigateUri="https://apps.apple.com/app/opensilver-showcase/id6746472943" TargetName="_blank" Foreground="{DynamicResource Theme_TextBrush}">Apple App Store</Hyperlink>.
                                                                    <LineBreak/>
                                                                    <LineBreak/>In that mode, your C# code compiles to native for direct access to platform APIs, while the
                                                                    UI renders through an embedded WebView, ensuring pixel-perfect visuals and full compatibility
                                                                    with any JavaScript components in your XAML. 
                                                                    <LineBreak/>
                                                                    <LineBreak/>This page shows how to call native APIs from C#, and how to detect at runtime whether the app
                                                                    is running in a browser or native environment to adjust behavior accordingly. In native mode,
                                                                    you can even combine browser APIs with native platform APIs for maximum flexibility.
            </TextBlock>
        </StackPanel>

        <ItemsControl x:Name="SamplesPanel" local:ItemsControlLoadingBehavior.ShowLoadingOnGenerating="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controlskit:StaggeredPanel ProgressiveRenderingChunkSize="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <local:Geolocation HorizontalAlignment="Center"/>
            <local:Flashlight_Demo HorizontalAlignment="Center"/>
            <local:Vibration_Demo HorizontalAlignment="Center"/>
            <local:OrientationSensors_Demo HorizontalAlignment="Center"/>
            <local:DisplayInfo_Demo HorizontalAlignment="Center"/>
            <local:Battery_Demo HorizontalAlignment="Center"/>
            <local:Shake_Demo HorizontalAlignment="Center"/>
            <local:Barometer_Demo HorizontalAlignment="Center"/>
            <local:FilePickerAndShare_Demo HorizontalAlignment="Center"/>
            <local:Connectivity_Demo HorizontalAlignment="Center"/>
            <local:OpenMapApp_Demo HorizontalAlignment="Center"/>
            <local:Camera_Demo HorizontalAlignment="Center"/>

        </ItemsControl>
    </StackPanel>

</Page>
