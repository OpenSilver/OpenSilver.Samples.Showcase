<local:ChartDemo x:Class="OpenSilver.Showcase.PieSeries_Demo"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:OpenSilver.Showcase"
                 xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Background="#FFD2BD9C"
                            Content="PieSeries"
                            Foreground="#FFDEA542"
                            Style="{StaticResource HeaderControl_Style}"/>
            <Chart Grid.Row="1">
                <Chart.Series>
                    <PieSeries x:Name="CostsSeries"
                               Title="Production costs"
                               DependentValuePath="Cost"
                               IndependentValuePath="Name"/>
                </Chart.Series>
            </Chart>
            <shared:ViewSourceButton Grid.Row="2" Background="#FCAB54">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo FileName="PieSeries_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/Charts/PieSeries"/>
                    <shared:ViewSourceButtonInfo FileName="PieSeries_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/Charts/PieSeries"/>
                    <shared:ViewSourceButtonInfo FileName="PieSeries_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/Charts/PieSeries"/>
                    <shared:ViewSourceButtonInfo FileName="PieSeries_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/Charts/PieSeries"/>
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</local:ChartDemo>
