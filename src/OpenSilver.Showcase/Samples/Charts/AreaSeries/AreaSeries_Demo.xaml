<local:ChartDemo x:Class="OpenSilver.Showcase.AreaSeries_Demo"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:OpenSilver.Showcase"
                 xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Background="#FFD2BD9C"
                            Content="AreaSeries"
                            Foreground="#FFDEA542"
                            Style="{StaticResource HeaderControl_Style}"/>
            <Chart Grid.Row="1">
                <Chart.Axes>
                    <CategoryAxis Title="Period" Orientation="X"/>
                    <CategoryAxis Title="Sales" Orientation="Y"/>
                </Chart.Axes>
                <Chart.Series>
                    <AreaSeries x:Name="ChairsSeries"
                                Title="Chairs"
                                DependentValuePath="Sales"
                                IndependentValuePath="Month"/>
                    <AreaSeries x:Name="TablesSeries"
                                Title="Tables"
                                DependentValuePath="Sales"
                                IndependentValuePath="Month"/>
                </Chart.Series>
            </Chart>
            <shared:ViewSourceButton Grid.Row="2" Background="#FCAB54">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo FileName="AreaSeries_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/Charts/AreaSeries"/>
                    <shared:ViewSourceButtonInfo FileName="AreaSeries_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/Charts/AreaSeries"/>
                    <shared:ViewSourceButtonInfo FileName="AreaSeries_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/Charts/AreaSeries"/>
                    <shared:ViewSourceButtonInfo FileName="AreaSeries_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/Charts/AreaSeries"/>
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</local:ChartDemo>
