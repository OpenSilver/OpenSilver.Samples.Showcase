<UserControl x:Class="OpenSilver.Showcase.PWA_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Width="255" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="Progressive Web App"
                            Foreground="#FF33AB2B"
                            Style="{StaticResource HeaderControl_Style}"/>

            <TextBlock Grid.Row="1"
                       FontSize="14"
                       Foreground="#FF808080"
                       TextWrapping="Wrap">
                Follow <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/aspnet/core/blazor/progressive-web-app#convert-an-existing-blazor-webassembly-app-into-a-pwa" TargetName="_blank">the instructions</Hyperlink>
                to convert any OpenSilver application into a <Hyperlink NavigateUri="https://developer.mozilla.org/en-US/docs/Web/Progressive_web_apps" TargetName="_blank">Progressive Web Application (PWA)</Hyperlink>.
                <LineBreak/>
                <LineBreak/>This showcase app <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/aspnet/core/blazor/progressive-web-app#installation-and-app-manifest" TargetName="_blank">can be installed</Hyperlink>
                on both desktop and mobile devices. It will work offline and behave similarly to native apps.</TextBlock>

            <local:ViewSourceButton Grid.Row="2" Background="#FF33AB2B">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="PWA_Demo.xaml" RelativePath="src/OpenSilver.Showcase/Samples/Interop_Samples/PWA"/>
                    <local:ViewSourceButtonInfo FileName="PWA_Demo.xaml.cs" RelativePath="src/OpenSilver.Showcase/Samples/Interop_Samples/PWA"/>
                    <local:ViewSourceButtonInfo FileName="PWA_Demo.xaml.vb" RelativePath="src/OpenSilver.Showcase/Samples/Interop_Samples/PWA"/>
                    <local:ViewSourceButtonInfo FileName="PWA_Demo.xaml.fs" RelativePath="src/OpenSilver.Showcase/Samples/Interop_Samples/PWA"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
