<Grid x:Class="OpenSilver.Showcase.ViewSourcePanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TabControl Name="TabControl"/>

    <StackPanel Grid.Row="1"
                Margin="20,0,0,5"
                Orientation="Horizontal">
        <Border Padding="3"
                Background="{DynamicResource Theme_BackgroundBrush}"
                CornerRadius="7">
            <StackPanel Orientation="Horizontal">
                <RadioButton Name="cSharpButton"
                             Checked="OnCSharpRadioButtonChecked"
                             Content="C#"/>
                <RadioButton Checked="OnVBNETRadioButtonChecked" Content="VB.NET" Margin="15,0"/>
                <RadioButton Checked="OnFSharpRadioButtonChecked" Content="F#"/>
            </StackPanel>
        </Border>

        <TransitioningContentControl Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Content="{Binding ElementName=TabControl, Path=SelectedItem.DataContext.Notes}"
                                     FontSize="14"
                                     Foreground="{DynamicResource Theme_ErrorBrush}"/>
    </StackPanel>
</Grid>
