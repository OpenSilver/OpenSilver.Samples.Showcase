<UserControl x:Class="OpenSilver.Samples.Showcase.TabControl_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="220" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <ContentControl Background="#FF8FCBBE"
                            Content="TabControl"
                            Foreground="#FF89B8AD"
                            Style="{StaticResource HeaderControl_Style}"/>
            
            <TabControl x:Name="MyTabControl"
                        Grid.Row="1"
                        HorizontalAlignment="Center">
                <TabItem Header="Tab 1" IsSelected="True">
                    <TextBlock Margin="20"
                               Text="Content of Tab 1"
                               TextWrapping="Wrap"/>
                </TabItem>
                <TabItem Header="Tab 2">
                    <TextBlock Margin="20"
                               Text="Content of Tab 2"
                               TextWrapping="Wrap"/>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15"
                                  Height="15"
                                  Margin="0,0,3,0"
                                  Data="M8.3560181,18.363037C10.371002,19.880005 12.873993,20.779053 15.584991,20.779053 18.295013,20.779053 20.799011,19.880005 22.813995,18.363037 27.524017,18.955994 31.167999,22.973022 31.167999,27.843994L31.167999,32 0,32 0,27.843994C0,22.973022,3.6459961,18.955994,8.3560181,18.363037z M15.584991,0C20.403992,0 24.311005,3.90802 24.311005,8.7280273 24.311005,13.548035 20.403992,17.454041 15.584991,17.454041 10.765015,17.454041 6.8580017,13.548035 6.8580017,8.7280273 6.8580017,3.90802 10.765015,0 15.584991,0z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                  Stretch="Fill"/>
                            <TextBlock Text="Tab 3"/>
                        </StackPanel>
                    </TabItem.Header>
                    <TextBlock Margin="20"
                               Text="Content of Tab 3"
                               TextWrapping="Wrap"/>
                </TabItem>
            </TabControl>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Margin="5,0"
                           VerticalAlignment="Center"
                           Text="TabStripPlacement"/>
                <ComboBox ItemsSource="{Binding Converter={StaticResource EnumToListConverter}, ConverterParameter={x:Type Dock}}" SelectedItem="{Binding TabStripPlacement, ElementName=MyTabControl, Mode=TwoWay}"/>
            </StackPanel>
            
            <local:ViewSourceButton Grid.Row="3" Background="#FF3ED4B2">                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="TabControl_Demo.xaml" RelativePath="src/Samples/XAML_Layout/TabControl"/>
                    <local:ViewSourceButtonInfo FileName="TabControl_Demo.xaml.cs" RelativePath="src/Samples/XAML_Layout/TabControl"/>
                    <local:ViewSourceButtonInfo FileName="TabControl_Demo.xaml.vb" RelativePath="src/Samples/XAML_Layout/TabControl"/>
                    <local:ViewSourceButtonInfo FileName="TabControl_Demo.xaml.fs" RelativePath="src/Samples/XAML_Layout/TabControl"/>
                    <local:ViewStyleSourceInfo TabHeader="Default TabControl Styles" RelativePath="src/Runtime/Controls/Themes" Fragment="#L606-L1491"/>
                    <local:ViewModernStyleSourceInfo TabHeader="Modern TabControl Styles" FileName="OpenSilver.Controls.xaml" Fragment="#L796-L1102"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
