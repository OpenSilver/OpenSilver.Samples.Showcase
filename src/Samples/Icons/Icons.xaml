<Page
    x:Class="OpenSilver.Samples.Showcase.Icons"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
    xmlns:search="clr-namespace:OpenSilver.Samples.Showcase.Search"
    xmlns:local="clr-namespace:OpenSilver.Samples.Showcase"
    Title="Icons - OpenSilver Features Showcase">
    <Page.Resources>
        <FontFamily x:Key="MaterialIconsRegular_FontFamily">ms-appx:///OpenSilver.Samples.Showcase/Samples/Icons/MaterialIcons-Regular.ttf</FontFamily>
    </Page.Resources>
    <StackPanel>
        <StackPanel>
            <ContentControl Content="Icons" Style="{StaticResource PageTitle_Style}"/>
            <TextBlock Style="{StaticResource PageIntroText_Style}">
            <Run Text="OpenSilver makes it simple to incorporate icons into your application. Common approaches include:"/>
            <LineBreak/>
            <Run Text="• Using the "/>
            <Run FontStyle="Italic" Text="Image"/>
            <Run Text=" control to display SVG files (tip: use the "/>
            <Run FontStyle="Italic" Text="SvgImage"/>
            <Run Text=" control for runtime color customization)."/>
            <LineBreak/>
            <Run Text="• Using symbol fonts (e.g. Google Material Icons...) rendered via a "/>
            <Run FontStyle="Italic" Text="TextBlock"/>
            <Run Text="."/>
            <LineBreak/>
            <Run Text="• Using Emojis characters."/>
            <LineBreak/>
            <LineBreak/>
            <Run Text="Click any icon below to instantly copy the corresponding XAML code snippet."/>
            </TextBlock>
        </StackPanel>

        <TabControl x:Name="tabControl" Margin="16,30,16,30">
            <TabItem Header="Material Icons" IsSelected="True">
                <TextBlock x:Name="MaterialIconsTextBlock" TextWrapping="Wrap" Margin="0,20,0,20" FontSize="24" Cursor="Hand" FontFamily="{StaticResource MaterialIconsRegular_FontFamily}"/>
            </TabItem>
            <TabItem Header="Emoji Characters">
                <TextBlock x:Name="EmojiCharactersTextBlock" TextWrapping="Wrap" Margin="0,20,0,20" FontSize="24" Cursor="Hand" FontFamily="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, sans-serif"/>
            </TabItem>
        </TabControl>

    </StackPanel>
</Page>
