<ChildWindow x:Class="OpenSilver.Samples.Showcase.CodeSnippetChildWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
           Width="300"
           Title="Code Snippet"
           xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Margin="20" FontSize="14" LineHeight="24">Copy/paste the following XAML snippet into your OpenSilver app to display the icon:</TextBlock>
        <TextBox x:Name="SnippetTextBox" Grid.Row="1" Height="100" Margin="18,0,20,12" IsReadOnly="True" TextWrapping="Wrap" FontFamily="monospace" VerticalScrollBarVisibility="Auto"/>
        <Button x:Name="OKButton" Content="Close" Click="OKButton_Click" Width="88" Height="32" HorizontalAlignment="Right" Margin="0,8,20,20" Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource Theme_PrimaryBrush}"/>
    </Grid>
</ChildWindow>