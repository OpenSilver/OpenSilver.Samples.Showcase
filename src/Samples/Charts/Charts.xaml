<Page x:Class="OpenSilver.Samples.Showcase.Charts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase"
             Style="{StaticResource Page_Style}">
    
    <StackPanel>
        <StackPanel>
            <ContentControl Content="Charts" Style="{StaticResource PageTitle_Style}"/>
            <TextBlock Style="{StaticResource PageIntroText_Style}">OpenSilver includes a rich set of built-in <Hyperlink NavigateUri="https://github.com/OpenSilver/OpenSilver/tree/develop/src/Runtime/Controls.DataVisualization" TargetName="_blank" Foreground="{DynamicResource Theme_TextBrush}">open-source</Hyperlink>
                                                                    chart components, covering common types such as line, bar, pie, area,
                                                                    scatter, and more. They are fully customizable through XAML and support
                                                                    data binding.
            </TextBlock>
        </StackPanel>
        
        <controlskit:StaggeredPanel DesiredColumnWidth="700" ProgressiveRenderingChunkSize="2">
            <local:AreaSeries_Demo/>
            <local:BarSeries_Demo/>
            <local:BubbleSeries_Demo/>
            <local:ColumnSeries_Demo/>
            <local:LineSeries_Demo/>
            <local:PieSeries_Demo/>
            <local:ScatterSeries_Demo/>
            <local:Stacked100AreaSeries_Demo/>
        </controlskit:StaggeredPanel>
    </StackPanel>
</Page>
