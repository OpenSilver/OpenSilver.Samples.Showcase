<Page x:Class="OpenSilver.Samples.Showcase.JS_Libs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase"
             Style="{StaticResource Page_Style}">

    <StackPanel>
        <StackPanel>
            <ContentControl Content="JS Libs" Style="{StaticResource PageTitle_Style}"/>
            <TextBlock Style="{StaticResource PageIntroText_Style}">OpenSilver seamlessly bridges C#/XAML with the vast JavaScript ecosystem.
                                                                    Since XAML is rendered as HTML, you can easily integrate JavaScript-based
                                                                    components directly into your applications alongside XAML controls. This
                                                                    flexibility gives you access to tens of thousands of JavaScript libraries
                                                                    and UI components. This page shows how easily JavaScript libraries can
                                                                    extend your OpenSilver apps.
            </TextBlock>
        </StackPanel>

        <controlskit:StaggeredPanel DesiredColumnWidth="280" ProgressiveRenderingChunkSize="2">
            <local:JSZip_Demo/>
            <local:ColorPicker_Demo/>
            <local:MonacoEditor_Demo/>
            <local:ToastUiEditor_Demo/>
        </controlskit:StaggeredPanel>
    </StackPanel>
</Page>