<UserControl x:Class="OpenSilver.Samples.Showcase.Command_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Background="#FFDCA59C"
                            Content="Command"
                            Foreground="#FFF78069"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.DataContext>
                    <local:CommandDemoViewModel/>
                </StackPanel.DataContext>

                <Button Command="{Binding ShowMessageCommand}"
                        CommandParameter="{Binding Message}"
                        Content="Test command"/>
                <TextBox Margin="0,10,0,0" Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2" Background="#FFF78069">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="Commanding_Demo.xaml" RelativePath="src/Samples/XAML_Features/Command"/>
                    <local:ViewSourceButtonInfo FileName="CommandDemoViewModel.xaml.cs" RelativePath="src/Samples/XAML_Features/Command"/>
                    <local:ViewSourceButtonInfo FileName="CommandDemoViewModel.xaml.vb" RelativePath="src/Samples/XAML_Features/Command"/>
                    <local:ViewSourceButtonInfo FileName="CommandDemoViewModel.xaml.fs" RelativePath="src/Samples/XAML_Features/Command"/>
                    <local:ViewSourceButtonInfo FileName="RelayCommand.cs" RelativePath="src/Other"/>
                    <local:ViewSourceButtonInfo FileName="RelayCommand.vb" RelativePath="src/Other"/>
                    <local:ViewSourceButtonInfo FileName="RelayCommand.fs" RelativePath="src/Other"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
