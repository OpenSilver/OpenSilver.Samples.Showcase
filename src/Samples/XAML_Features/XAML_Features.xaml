<UserControl x:Class="OpenSilver.Samples.Showcase.Xaml_Features"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <StackPanel>
        <Grid>
            <ContentControl Style="{StaticResource PageHeader_Style}" Content="XAML Features"/>
            <!--<WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Foreground="Transparent"
                           Style="{StaticResource PageHeader_Style}"
                           Text="XAML Features"/>
                <local:SearchControl HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                <Border Width="30"/>
            </WrapPanel>-->
        </Grid>

        <controlskit:StaggeredPanel DesiredColumnWidth="280" ProgressiveRenderingChunkSize="2">
            <local:RenderTransforms_Demo HorizontalAlignment="Center"/>
            <local:Drag_And_Drop_Demo HorizontalAlignment="Center"/>
            <local:Binding1_Demo x:Name="Binding1Demo" HorizontalAlignment="Center"/>
            <local:Binding2_Demo HorizontalAlignment="Center"/>
            <local:Binding3_Demo HorizontalAlignment="Center"/>
            <local:Command_Demo/>
            <local:Gradients_Demo HorizontalAlignment="Center"/>
            <local:Styles_Demo/>
            <local:Themes_Demo/>
            <local:Triggers_Demo/>
            <local:XamlReader_Demo/>
            <local:MeasureArrange_Demo/>
            <local:Animations_Demo HorizontalAlignment="Center"/>
            <local:DropShadowEffect_Demo HorizontalAlignment="Center"/>
            <local:ImageBrush_Demo/>
            <local:Window_SizeChanged_Demo HorizontalAlignment="Center"/>
            <local:FindElementsInHostCoordinates_Demo HorizontalAlignment="Center"/>
            <local:TransformToVisual_Demo/>
            <local:ClipToBounds_Demo HorizontalAlignment="Center"/>
            <local:Validation_Demo HorizontalAlignment="Center"/>
            <local:MouseWheel_Demo HorizontalAlignment="Center"/>
            <local:InteractivityTriggers_Demo HorizontalAlignment="Center"/>
            <local:XAML_Resource_Dictionary_Demo HorizontalAlignment="Center"/>
            <local:DependencyProperties_Demo HorizontalAlignment="Center"/>
            <local:AttachedProperties_Demo HorizontalAlignment="Center"/>
            <local:VisualTreeHelper_Demo HorizontalAlignment="Center"/>
            <local:MarkupExtensions_Demo x:Name="MarkupExtensionsDemo" HorizontalAlignment="Center"/>
            <local:UriMapper_Demo HorizontalAlignment="Center"/>
            <local:PropertyChangedTrigger_Demo HorizontalAlignment="Center"/>
        </controlskit:StaggeredPanel>
    </StackPanel>
</UserControl>
