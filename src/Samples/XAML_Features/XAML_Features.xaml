<Page x:Class="OpenSilver.Samples.Showcase.Xaml_Features"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
      xmlns:local="clr-namespace:OpenSilver.Samples.Showcase"
      Style="{StaticResource Page_Style}">

    <StackPanel>
        <StackPanel>
            <ContentControl Content="XAML Features" Style="{StaticResource PageTitle_Style}"/>
            <TextBlock Style="{StaticResource PageIntroText_Style}">OpenSilver brings the full power of WPF’s XAML capabilities (with triggers
                                                                    and adorners coming soon). This section highlights key XAML features.
                                                                    As a declarative language, XAML also supports a rich drag-and-drop design
                                                                    experience. Try it online at <Hyperlink NavigateUri="https://xaml.io" TargetName="_blank" Foreground="{DynamicResource Theme_TextBrush}">XAML.io</Hyperlink>
                                                                    (no installation needed), or use the OpenSilver extension (VSIX) <Hyperlink NavigateUri="https://marketplace.visualstudio.com/items?itemName=userware.OpenSilverSDK" TargetName="_blank" Foreground="{DynamicResource Theme_TextBrush}">for Visual Studio</Hyperlink> and <Hyperlink NavigateUri="https://marketplace.visualstudio.com/items?itemName=userware.vscode-opensilver" TargetName="_blank" Foreground="{DynamicResource Theme_TextBrush}">for VS Code</Hyperlink>
                                                                    for integrated design tools.
            </TextBlock>
        </StackPanel>
        
        <ItemsControl x:Name="SamplesPanel" local:ItemsControlLoadingBehavior.ShowLoadingOnGenerating="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controlskit:StaggeredPanel DesiredColumnWidth="280" ProgressiveRenderingChunkSize="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <local:RenderTransforms_Demo HorizontalAlignment="Center"/>
            <local:Drag_And_Drop_Demo HorizontalAlignment="Center"/>
            <local:Binding1_Demo x:Name="Binding1Demo" HorizontalAlignment="Center"/>
            <local:Binding2_Demo HorizontalAlignment="Center"/>
            <local:Binding3_Demo HorizontalAlignment="Center"/>
            <local:MultiBinding_Demo/>
            <local:Command_Demo/>
            <local:Gradients_Demo HorizontalAlignment="Center"/>
            <local:Styles_Demo/>
            <local:Themes_Demo/>
            <local:Triggers_Demo/>
            <local:XamlReader_Demo/>
            <local:Animations_Demo HorizontalAlignment="Center"/>
            <local:AnimationTool_Demo/>
            <local:DropShadowEffect_Demo HorizontalAlignment="Center"/>
            <local:ImageBrush_Demo/>
            <local:Window_SizeChanged_Demo HorizontalAlignment="Center"/>
            <local:FindElementsInHostCoordinates_Demo HorizontalAlignment="Center"/>
            <local:TransformToVisual_Demo/>
            <local:ClipToBounds_Demo HorizontalAlignment="Center"/>
            <local:Validation_Demo HorizontalAlignment="Center"/>
            <local:MouseWheel_Demo HorizontalAlignment="Center"/>
            <local:InteractivityTriggers_Demo HorizontalAlignment="Center"/>
            <local:XAML_Resource_Dictionary_Demo HorizontalAlignment="Center"/>
            <local:DependencyProperties_Demo HorizontalAlignment="Center"/>
            <local:AttachedProperties_Demo HorizontalAlignment="Center"/>
            <local:VisualTreeHelper_Demo HorizontalAlignment="Center"/>
            <local:MarkupExtensions_Demo x:Name="MarkupExtensionsDemo" HorizontalAlignment="Center"/>
            <local:UriMapper_Demo HorizontalAlignment="Center"/>
            <local:PropertyChangedTrigger_Demo HorizontalAlignment="Center"/>
            <local:Behaviors_Demo/>
            <local:Clipping_Demo/>
            <local:Cursor_Demo/>
            <local:FlowDirection_Demo/>
            
        </ItemsControl>
    </StackPanel>
</Page>
