<UserControl x:Class="OpenSilver.Samples.Showcase.Behaviors_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="255" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="Behaviors"
                            Foreground="#FF5F9EA0"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1" Margin="10">
                <!--  MouseDragElementBehavior Example  -->
                <TextBlock Margin="0,0,0,5"
                           FontWeight="Bold"
                           Foreground="#FF5F9EA0"
                           Text="MouseDragElementBehavior"/>
                <CheckBox Margin="0,0,0,5"
                          Content="ConstrainToParentBounds"
                          FontSize="11"
                          IsChecked="{Binding ElementName=mouseDragElementBehavior, Path=ConstrainToParentBounds, Mode=TwoWay}"/>
                <Border Margin="0,0,0,15"
                        Padding="8"
                        BorderBrush="LightGray"
                        BorderThickness="1">
                    <Border Width="60"
                            Height="30"
                            Margin="0,5,0,0"
                            Background="#FF5F9EA0"
                            Cursor="Hand">
                        <i:Interaction.Behaviors>
                            <ei:MouseDragElementBehavior x:Name="mouseDragElementBehavior" ConstrainToParentBounds="True"/>
                        </i:Interaction.Behaviors>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="Drag me!"/>
                    </Border>
                </Border>

                <!--  FluidMoveBehavior Example  -->
                <TextBlock Margin="0,0,0,5"
                           FontWeight="Bold"
                           Foreground="#FF5F9EA0"
                           Text="FluidMoveBehavior"/>
                <TextBlock Margin="0,0,0,5"
                           Text="Provides smooth transition animations. Click the buttons to move the rectangle."
                           TextWrapping="Wrap"/>
                <StackPanel Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="MoveLeftButton"
                            Click="OnMoveLeftButtonClick"
                            Content="⬅"/>
                    <Button x:Name="MoveRightButton"
                            Margin="10,0,0,0"
                            Click="OnMoveRightButtonClick"
                            Content="➡"/>
                </StackPanel>
                <Canvas Width="200"
                        Height="50"
                        HorizontalAlignment="Center">
                    <Rectangle x:Name="MovingRectangle"
                               Canvas.Left="80"
                               Width="40"
                               Height="40"
                               Fill="#FF5F9EA0">
                        <i:Interaction.Behaviors>
                            <ei:FluidMoveBehavior Duration="0:0:0.5"/>
                        </i:Interaction.Behaviors>
                    </Rectangle>
                </Canvas>
                <TextBlock Margin="0,0,0,5"
                           Text="Click the buttons to animate children."
                           TextWrapping="Wrap"/>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="0,0,10,0"
                            Click="OnAddButtonClick"
                            Content="Add"/>
                    <Button Name="RemoveButton"
                            Click="OnRemoveButtonClick"
                            Content="Remove"/>
                </StackPanel>
                <WrapPanel Name="wrapPanel">
                    <WrapPanel.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF5F9EA0"/>
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="20"/>
                            <Setter Property="Margin" Value="5"/>
                        </Style>
                    </WrapPanel.Resources>
                    <i:Interaction.Behaviors>
                        <ei:FluidMoveBehavior AppliesTo="Children" Duration="0:0:0.5"/>
                    </i:Interaction.Behaviors>
                    <Border/>
                    <Border/>
                    <Border/>
                    <Border/>
                    <Border/>
                    <Border/>
                </WrapPanel>

                <!--  DataStateBehavior Example  -->
                <TextBlock Margin="0,10,0,5"
                           FontWeight="Bold"
                           Foreground="#FF5F9EA0"
                           Text="DataStateBehavior"/>
                <CheckBox x:Name="StateCheckBox"
                          Content="Toggle State"
                          FontSize="11"
                          IsChecked="True"/>
                <Border x:Name="StateTarget"
                        Width="30"
                        Height="30"
                        Background="Gray">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CheckStates">
                            <VisualState x:Name="CheckedState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FF5F9EA0"
                                                    Duration="0:0:0.3"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="UncheckedState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="Red"
                                                    Duration="0:0:0.3"/>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <i:Interaction.Behaviors>
                        <ei:DataStateBehavior Binding="{Binding IsChecked, ElementName=StateCheckBox}"
                                              FalseState="UncheckedState"
                                              TrueState="CheckedState"
                                              Value="True"/>
                    </i:Interaction.Behaviors>
                </Border>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2" Background="#FF5F9EA0">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="Behaviors_Demo.xaml" RelativePath="src/Samples/XAML_Features/Behaviors"/>
                    <local:ViewSourceButtonInfo FileName="Behaviors_Demo.xaml.cs" RelativePath="src/Samples/XAML_Features/Behaviors"/>
                    <local:ViewSourceButtonInfo FileName="Behaviors_Demo.xaml.vb" RelativePath="src/Samples/XAML_Features/Behaviors"/>
                    <local:ViewSourceButtonInfo FileName="Behaviors_Demo.xaml.fs" RelativePath="src/Samples/XAML_Features/Behaviors"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
