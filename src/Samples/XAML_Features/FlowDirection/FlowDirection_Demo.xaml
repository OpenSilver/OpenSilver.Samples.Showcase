<UserControl x:Class="OpenSilver.Samples.Showcase.FlowDirection_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="FlowDirection"
                            Foreground="#FF9C27B0"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1" Margin="10">
                <TextBlock Text="Change FlowDirection:"/>
                <ComboBox Margin="0,5,0,0"
                          ItemsSource="{Binding Converter={StaticResource EnumToListConverter}, ConverterParameter={x:Static FrameworkElement.FlowDirectionProperty}}"
                          SelectedItem="{Binding ElementName=DemoPanel, Path=FlowDirection, Mode=TwoWay}"/>

                <StackPanel x:Name="DemoPanel" Margin="0,20,0,0">
                    <TextBlock Margin="0,0,0,10"
                               Text="The FlowDirection property affects alignment and items order:"
                               TextWrapping="Wrap"/>

                    <StackPanel>
                        <TextBox Margin="0,5" Text="TextBox"/>
                        <CheckBox Margin="0,5" Content="CheckBox"/>
                        <NumericUpDown Value="10"/>
                        <ComboBox Margin="0,5" SelectedIndex="0">
                            <ComboBoxItem>Item 1</ComboBoxItem>
                            <ComboBoxItem>Item 2</ComboBoxItem>
                        </ComboBox>
                        <Slider Value="2"/>
                        <ListBox Margin="0,5" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Content="Item 1"/>
                            <ListBoxItem Content="Item 2"/>
                            <ListBoxItem Content="Item 3"/>
                        </ListBox>
                        <TabControl>
                            <TabItem Header="Tab 1"/>
                            <TabItem Header="Tab 2"/>
                        </TabControl>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Column 1"/>
                            <Button Grid.Column="2" Content="Column 2"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2" Background="#FF9C27B0">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="FlowDirection_Demo.xaml" RelativePath="src/Samples/XAML_Features/FlowDirection"/>
                    <local:ViewSourceButtonInfo FileName="FlowDirection_Demo.xaml.cs" RelativePath="src/Samples/XAML_Features/FlowDirection"/>
                    <local:ViewSourceButtonInfo FileName="FlowDirection_Demo.xaml.vb" RelativePath="src/Samples/XAML_Features/FlowDirection"/>
                    <local:ViewSourceButtonInfo FileName="FlowDirection_Demo.xaml.fs" RelativePath="src/Samples/XAML_Features/FlowDirection"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>