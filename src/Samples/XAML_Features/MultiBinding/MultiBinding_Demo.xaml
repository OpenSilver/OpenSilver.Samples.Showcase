<UserControl x:Class="OpenSilver.Samples.Showcase.MultiBinding_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <UserControl.Resources>
        <local:RgbToBrushConverter x:Key="RgbToBrushConverter"/>
    </UserControl.Resources>

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="MultiBinding"
                            Foreground="#FFF78069"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <StackPanel.Resources>
                    <Style TargetType="Slider">
                        <Setter Property="Maximum" Value="255"/>
                        <Setter Property="LargeChange" Value="10"/>
                        <Setter Property="Margin" Value="20,5"/>
                    </Style>
                </StackPanel.Resources>
                <Slider x:Name="SliderRed" ToolTip="Red"/>
                <Slider x:Name="SliderGreen" ToolTip="Green"/>
                <Slider x:Name="SliderBlue" ToolTip="Blue"/>

                <TextBlock Margin="5"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Text="Combines the values from the Red, Green, and Blue sliders into Brush."
                           TextWrapping="Wrap"/>
                <Border Width="140"
                        Height="60"
                        BorderBrush="#FF676767"
                        BorderThickness="2"
                        CornerRadius="5">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                            <Binding ElementName="SliderRed" Path="Value"/>
                            <Binding ElementName="SliderGreen" Path="Value"/>
                            <Binding ElementName="SliderBlue" Path="Value"/>
                        </MultiBinding>
                    </Border.Background>
                </Border>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2" Background="#FFF78069">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="MultiBinding_Demo.xaml" RelativePath="src/Samples/XAML_Features/MultiBinding"/>
                    <local:ViewSourceButtonInfo FileName="MultiBinding_Demo.xaml.cs" RelativePath="src/Samples/XAML_Features/MultiBinding"/>
                    <local:ViewSourceButtonInfo FileName="MultiBinding_Demo.xaml.vb" RelativePath="src/Samples/XAML_Features/MultiBinding"/>
                    <local:ViewSourceButtonInfo FileName="MultiBinding_Demo.xaml.fs" RelativePath="src/Samples/XAML_Features/MultiBinding"/>
                    <local:ViewSourceButtonInfo FileName="RgbToBrushConverter.cs" RelativePath="src/Other/Converters"/>
                    <local:ViewSourceButtonInfo FileName="RgbToBrushConverter.vb" RelativePath="src/Other/Converters"/>
                    <local:ViewSourceButtonInfo FileName="RgbToBrushConverter.fs" RelativePath="src/Other/Converters"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
