<UserControl x:Class="OpenSilver.Samples.Showcase.BlurEffect_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="BlurEffect"
                            Foreground="#ff5370db"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1">
                <StackPanel>
                    <StackPanel.Effect>
                        <BlurEffect x:Name="BlurEffect" Radius="2"/>
                    </StackPanel.Effect>
                    <TextBlock x:Name="BlurredText"
                               Width="220"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        This text has a blur effect<LineBreak/>
                        applied on it.</TextBlock>

                    <Button x:Name="BlurredRectangle"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#FF9E5E5E"
                            Content="Button"/>
                </StackPanel>

                <!--  Controls for modifying the rectangle blur  -->
                <Border Margin="0,15,0,0"
                        Padding="5"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="NumericUpDown">
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Margin" Value="5"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--  Blur Radius Control  -->
                        <TextBlock Margin="0,0,5,0"
                                   VerticalAlignment="Center"
                                   Text="Radius"/>
                        <NumericUpDown Grid.Column="1"
                                       Increment="2"
                                       Maximum="30"
                                       Value="{Binding ElementName=BlurEffect, Path=Radius, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2" Background="#ff5370db">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="BlurEffect_Demo.xaml" RelativePath="src/Samples/XAML_Features/BlurEffect"/>
                    <local:ViewSourceButtonInfo FileName="BlurEffect_Demo.xaml.cs" RelativePath="src/Samples/XAML_Features/BlurEffect"/>
                    <local:ViewSourceButtonInfo FileName="BlurEffect_Demo.xaml.vb" RelativePath="src/Samples/XAML_Features/BlurEffect"/>
                    <local:ViewSourceButtonInfo FileName="BlurEffect_Demo.xaml.fs" RelativePath="src/Samples/XAML_Features/BlurEffect"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
