<UserControl x:Class="OpenSilver.Samples.Showcase.MarkupExtensions_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Background="#FFA1C3D7"
                            Content="MarkupExtensions"
                            Foreground="#FF33B4FF"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1" Margin="0,20">
                <TextBlock FontSize="12"
                           Text="String from .resx file using custom MarkupExtension:"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource Theme_PrimaryBrush}"
                           Text="{local:Resx InfoMessage}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>


            <local:ViewSourceButton Grid.Row="2" Background="#FF33B4FF">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="MarkupExtensions_Demo.xaml" RelativePath="src/Samples/XAML_Features/MarkupExtensions"/>
                    <local:ViewSourceButtonInfo FileName="MarkupExtensions_Demo.xaml.cs" RelativePath="src/Samples/XAML_Features/MarkupExtensions"/>
                    <local:ViewSourceButtonInfo FileName="MarkupExtensions_Demo.xaml.vb" RelativePath="src/Samples/XAML_Features/MarkupExtensions"/>
                    <local:ViewSourceButtonInfo FileName="MarkupExtensions_Demo.xaml.fs" RelativePath="src/Samples/XAML_Features/MarkupExtensions"/>
                    <local:ViewSourceButtonInfo FileName="ResxExtension.cs" RelativePath="src/Other/MarkupExtensions"/>
                    <local:ViewSourceButtonInfo FileName="ResxExtension.vb" RelativePath="src/Other/MarkupExtensions"/>
                    <local:ViewSourceButtonInfo FileName="ResxExtension.fs" RelativePath="src/Other/MarkupExtensions"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
