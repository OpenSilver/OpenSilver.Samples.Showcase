<UserControl x:Class="OpenSilver.Samples.Showcase.VisualTreeHelper_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="VisualTreeHelper &amp; LogicalTreeHelper"
                            Foreground="#FF33B4FF"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1">
                <TextBlock HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="#FF808080"
                           Text="Click the following button to see the Visual Tree and Logical Tree of this example:"
                           TextWrapping="Wrap"/>
                <Button Margin="0,10,0,0"
                        Click="RevealTree_Click"
                        Content="Show Elements Tree"/>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2"
                                    Margin="0,10,0,0"
                                    Background="#FF33B4FF">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="VisualTreeHelper_Demo.xaml" RelativePath="src/Samples/XAML_Features/VisualTreeHelper"/>
                    <local:ViewSourceButtonInfo FileName="VisualTreeHelper_Demo.xaml.cs" RelativePath="src/Samples/XAML_Features/VisualTreeHelper"/>
                    <local:ViewSourceButtonInfo FileName="VisualTreeHelper_Demo.xaml.vb" RelativePath="src/Samples/XAML_Features/VisualTreeHelper"/>
                    <local:ViewSourceButtonInfo FileName="VisualTreeHelper_Demo.xaml.fs" RelativePath="src/Samples/XAML_Features/VisualTreeHelper"/>
                    <local:ViewSourceButtonInfo FileName="TreeViewerWindow.xaml" RelativePath="src/Samples/XAML_Features/VisualTreeHelper"/>
                    <local:ViewSourceButtonInfo FileName="TreeViewerWindow.xaml.cs" RelativePath="src/Samples/XAML_Features/VisualTreeHelper"/>
                    <local:ViewSourceButtonInfo FileName="TreeViewerWindow.xaml.vb" RelativePath="src/Samples/XAML_Features/VisualTreeHelper"/>
                    <local:ViewSourceButtonInfo FileName="TreeViewerWindow.xaml.fs" RelativePath="src/Samples/XAML_Features/VisualTreeHelper"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
