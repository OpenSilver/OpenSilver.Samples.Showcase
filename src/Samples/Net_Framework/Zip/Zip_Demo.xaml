<UserControl x:Class="OpenSilver.Samples.Showcase.Zip_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="using:OpenSilver.Extensions.FileOpenDialog"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="Zip"
                            Foreground="#FF6F7DFF"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1">
                <TextBlock HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="#FF808080"
                           Text="Click the following button to generate and save a new ZIP file containing a text file with the Hello World text:"
                           TextWrapping="Wrap"/>
                <Button Grid.Row="1"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Click="ButtonGenerateZip_Click"
                        Content="Click to Generate ZIP File"/>
                <TextBlock x:Name="SavingNotSupportedLabel"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Theme_ErrorBrush}"
                           Text="NOTE: Saving files is not supported on the current platform yet."
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2" Background="#FF6F7DFF">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="Zip_Demo.xaml" RelativePath="src/Samples/Net_Framework/Zip"/>
                    <local:ViewSourceButtonInfo FileName="Zip_Demo.xaml.cs" RelativePath="src/Samples/Net_Framework/Zip"/>
                    <local:ViewSourceButtonInfo FileName="Zip_Demo.xaml.vb" RelativePath="src/Samples/Net_Framework/Zip"/>
                    <local:ViewSourceButtonInfo FileName="Zip_Demo.xaml.fs" RelativePath="src/Samples/Net_Framework/Zip"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
