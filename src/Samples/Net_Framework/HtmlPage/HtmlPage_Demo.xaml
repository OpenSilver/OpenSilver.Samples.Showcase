<UserControl x:Class="OpenSilver.Samples.Showcase.HtmlPage_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:browser="clr-namespace:System.Windows.Browser;assembly=OpenSilver.Browser"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="245" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="HtmlPage"
                            Foreground="#FFB3BFA9"
                            Style="{StaticResource HeaderControl_Style}"/>

            <Grid Grid.Row="1">
                <Grid.Resources>
                    <Style TargetType="Label">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="5,5,0,5"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="DocumentUri"/>
                <TextBlock Name="documentUriTextBlock" Grid.Column="1"/>

                <Label Grid.Row="1" Content="Platform"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Source={x:Static browser:HtmlPage.BrowserInformation}, Path=Platform}"/>

                <Label Grid.Row="2" Content="Browser Name"/>
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding Source={x:Static browser:HtmlPage.BrowserInformation}, Path=Name}"/>

                <Label Grid.Row="3" Content="CookiesEnabled"/>
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding Source={x:Static browser:HtmlPage.BrowserInformation}, Path=CookiesEnabled}"/>

                <Label Grid.Row="4" Content="UserAgent"/>
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding Source={x:Static browser:HtmlPage.BrowserInformation}, Path=UserAgent}"/>
            </Grid>

            <local:ViewSourceButton Grid.Row="2" Background="#FFB3BFA9">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="HtmlPage_Demo.xaml" RelativePath="src/Samples/Net_Framework/HtmlPage"/>
                    <local:ViewSourceButtonInfo FileName="HtmlPage_Demo.xaml.cs" RelativePath="src/Samples/Net_Framework/HtmlPage"/>
                    <local:ViewSourceButtonInfo FileName="HtmlPage_Demo.xaml.vb" RelativePath="src/Samples/Net_Framework/HtmlPage"/>
                    <local:ViewSourceButtonInfo FileName="HtmlPage_Demo.xaml.fs" RelativePath="src/Samples/Net_Framework/HtmlPage"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
