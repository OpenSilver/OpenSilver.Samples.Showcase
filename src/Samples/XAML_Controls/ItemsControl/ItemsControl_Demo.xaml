<UserControl x:Class="OpenSilver.Samples.Showcase.ItemsControl_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="200" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="ItemsControl"
                            Foreground="#FF4CAF50"
                            Style="{StaticResource HeaderControl_Style}"/>

            <ScrollViewer Grid.Row="1"
                          Height="120"
                          HorizontalAlignment="Center">
                <ItemsControl FontSize="14" ItemsSource="{x:Static local:Planet.Planets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"/>
                                <Image Grid.Column="1"
                                       Height="20"
                                       Source="{Binding ImagePath}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <local:ViewSourceButton Grid.Row="2" Background="#FF4CAF50">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="ItemsControl_Demo.xaml" RelativePath="src/Samples/XAML_Controls/ItemsControl"/>
                    <local:ViewSourceButtonInfo FileName="ItemsControl_Demo.xaml.cs" RelativePath="src/Samples/XAML_Controls/ItemsControl"/>
                    <local:ViewSourceButtonInfo FileName="ItemsControl_Demo.xaml.vb" RelativePath="src/Samples/XAML_Controls/ItemsControl"/>
                    <local:ViewSourceButtonInfo FileName="ItemsControl_Demo.xaml.fs" RelativePath="src/Samples/XAML_Controls/ItemsControl"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
