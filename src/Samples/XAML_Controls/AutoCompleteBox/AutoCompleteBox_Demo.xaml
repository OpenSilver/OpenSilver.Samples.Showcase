<UserControl x:Class="OpenSilver.Samples.Showcase.AutoCompleteBox_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="220" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="AutoCompleteBox"
                            Foreground="#FFFF81E3"
                            Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1">
                <TextBlock Margin="5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#FF808080"
                           Text="Enter text:"/>
                <AutoCompleteBox x:Name="autoCompleteBox"
                                 FilterMode="{Binding SelectedItem, ElementName=FilterModeCombo, Mode=TwoWay}"
                                 MinimumPopulateDelay="{Binding Value, ElementName=MinimumPopulateDelaySlider}"
                                 MinimumPrefixLength="{Binding Value, ElementName=MinimumPrefixLengthUpDown}"/>
            </StackPanel>

            <Expander Grid.Row="2"
                      Margin="0,10,0,0"
                      Style="{StaticResource PopupExpanderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="FilterMode"/>
                    <ComboBox x:Name="FilterModeCombo"
                              Grid.Column="1"
                              Height="Auto"
                              FontSize="12"
                              ItemsSource="{Binding Converter={StaticResource EnumToListConverter}, ConverterParameter={x:Type AutoCompleteFilterMode}}"
                              SelectedIndex="1"/>

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="MinimumPopulateDelay"/>
                    <Slider x:Name="MinimumPopulateDelaySlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="2,5,0,5"
                            LargeChange="100"
                            Maximum="1000"
                            ToolTip="{Binding Value, RelativeSource={RelativeSource Mode=Self}, StringFormat={}{0} ms}"/>

                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center"
                               Text="MinimumPrefixLength"/>
                    <NumericUpDown x:Name="MinimumPrefixLengthUpDown"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   MinWidth="20"
                                   FontSize="12"
                                   Maximum="10"
                                   Minimum="1"/>
                </Grid>
            </Expander>

            <local:ViewSourceButton Grid.Row="3" Background="#FFFF81E3">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="AutoCompleteBox_Demo.xaml" RelativePath="src/Samples/XAML_Controls/AutoCompleteBox"/>
                    <local:ViewSourceButtonInfo FileName="AutoCompleteBox_Demo.xaml.cs" RelativePath="src/Samples/XAML_Controls/AutoCompleteBox"/>
                    <local:ViewSourceButtonInfo FileName="AutoCompleteBox_Demo.xaml.vb" RelativePath="src/Samples/XAML_Controls/AutoCompleteBox"/>
                    <local:ViewSourceButtonInfo FileName="AutoCompleteBox_Demo.xaml.fs" RelativePath="src/Samples/XAML_Controls/AutoCompleteBox"/>
                    <local:ViewStyleSourceInfo RelativePath="src/Runtime/Controls.Input/Themes" TabHeader="Default AutoCompleteBox Style"/>
                    <local:ViewModernStyleSourceInfo FileName="OpenSilver.Controls.Input.xaml" TabHeader="Modern AutoCompleteBox Style"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
