<Page x:Class="OpenSilver.Samples.Showcase.Xaml_Controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase"
             Style="{StaticResource Page_Style}">
    <Page.Resources>
        <Style x:Key="PageIntroText_Style" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Foreground" Value="{DynamicResource Theme_TextBrush}"/>
                <Setter Property="Opacity" Value="0.7"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="30,10,10,0"/>
                <Setter Property="MaxWidth" Value="800"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="LineHeight" Value="30"/>
            </Style.Setters>
        </Style>
        <Style x:Key="PageIntroContainer_Style" TargetType="ContentControl">
            <Style.Setters>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <StackPanel>
                                <Border Background="{DynamicResource Theme_BackgroundBrush}" Margin="-20,0,0,0" Padding="20,0,0,0">
                                    <ContentPresenter/>
                                </Border>
                                <Border Margin="-20,0,0,-90" Padding="20,0,0,0" Height="130" Background="{DynamicResource GradientFromBackgroundColorToTransparent}"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
        </Style>
    </Page.Resources>
    
    <StackPanel>
        <ContentControl Style="{StaticResource PageIntroContainer_Style}">
            <StackPanel>
                <ContentControl Content="Controls" Style="{StaticResource PageHeader_Style}"/>
                <TextBlock Style="{StaticResource PageIntroText_Style}">
                    OpenSilver contains over 100 built-in XAML controls. You can also migrate WPF,
                    Silverlight, or WinUI controls, and soon (in v3.3), you'll be able to also import
                    Blazor components. Need more? Easily integrate any JavaScript control from the
                    massive JS ecosystem via simple interop (see
                    <Hyperlink NavigateUri="JS_Libs.xaml" Foreground="{DynamicResource Theme_TextBrush}">examples</Hyperlink>).
                </TextBlock>
            </StackPanel>
        </ContentControl>

        <controlskit:StaggeredPanel Name="SamplesPanel" ProgressiveRenderingChunkSize="2">
            <local:TreeView_Demo HorizontalAlignment="Center"/>
            <local:TreeMap_Demo/>
            <local:InkPresenter_Demo/>
            <local:Button_Demo HorizontalAlignment="Center"/>
            <local:ButtonSpinner_Demo/>
            <local:TextBox_Demo HorizontalAlignment="Center"/>
            <local:CheckBox_Demo HorizontalAlignment="Center"/>
            <local:RadioButton_Demo HorizontalAlignment="Center"/>
            <local:TextBlock_Demo HorizontalAlignment="Center"/>
            <local:Label_Demo HorizontalAlignment="Center"/>
            <local:RichTextBlock_Demo/>
            <local:RichTextBox_Demo/>
            <local:Path_Demo HorizontalAlignment="Center"/>
            <local:ProgressBar_Demo/>
            <local:DataForm_Demo HorizontalAlignment="Center"/>
            <local:BusyIndicator_Demo HorizontalAlignment="Center"/>
            <local:Border_Demo HorizontalAlignment="Center"/>
            <local:ScrollViewer_Demo x:Name="ScrollViewerDemo" HorizontalAlignment="Center"/>
            <local:ToolTip_Demo HorizontalAlignment="Center"/>
            <local:HyperlinkButton_Demo HorizontalAlignment="Center"/>
            <local:NumericUpDown_Demo HorizontalAlignment="Center"/>
            <local:DomainUpDown_Demo/>
            <local:UpDownBase_Demo/>
            <local:ComboBox_Demo x:Name="ComboBoxDemo" HorizontalAlignment="Center"/>
            <local:RepeatButton_Demo HorizontalAlignment="Center"/>
            <local:GridSplitter_Demo HorizontalAlignment="Center"/>
            <local:ListBox_Demo x:Name="ListBoxDemo" HorizontalAlignment="Center"/>
            <local:ItemsControl_Demo/>
            <local:Slider_Demo HorizontalAlignment="Center"/>
            <local:TabControl_Demo HorizontalAlignment="Center"/>
            <local:ChildWindow_Demo HorizontalAlignment="Center"/>
            <local:NonModalChildWindow_Demo x:Name="NonModalChildWindow" HorizontalAlignment="Center"/>
            <local:ContextMenu_MenuItem_Demo x:Name="MenuItemDemo" HorizontalAlignment="Center"/>
            <local:ToggleButton_Demo HorizontalAlignment="Center"/>
            <local:Expander_Demo HorizontalAlignment="Center"/>
            <local:Accordion_Demo/>
            <local:HeaderedContentControl_Demo/>
            <local:PasswordBox_Demo HorizontalAlignment="Center"/>
            <local:ContextMenu_Demo x:Name="ContextMenuDemo" HorizontalAlignment="Center"/>
            <local:Image_Demo x:Name="ImageDemo" HorizontalAlignment="Center"/>
            <local:MediaElement_Demo x:Name="MediaElementDemo" HorizontalAlignment="Center"/>
            <local:AutoCompleteBox_Demo x:Name="AutoCompleteBoxDemo" HorizontalAlignment="Center"/>
            <local:Popup_Demo HorizontalAlignment="Center"/>
            <local:DataGrid_Demo x:Name="DataGridDemo" HorizontalAlignment="Center"/>
            <local:HtmlPresenter_Demo HorizontalAlignment="Center"/>
            <local:ScrollBar_Demo x:Name="ScrollBarDemo" HorizontalAlignment="Center"/>
            <local:Thumb_Demo x:Name="ThumbDemo" HorizontalAlignment="Center"/>
            <local:Viewbox_Demo HorizontalAlignment="Center"/>
            <local:Frame_Demo x:Name="FrameDemo" HorizontalAlignment="Center"/>
            <local:Shapes_Demo HorizontalAlignment="Center"/>
            <local:DatePicker_Demo x:Name="DatePickerDemo" HorizontalAlignment="Center"/>
            <local:TimePicker_Demo/>
            <local:Calendar_Demo/>
            <local:GlobalCalendar_Demo/>
            <local:Rating_Demo/>
            <local:LayoutTransformer_Demo/>
            <local:TransitioningContentControl_Demo/>
        </controlskit:StaggeredPanel>
    </StackPanel>
</Page>
