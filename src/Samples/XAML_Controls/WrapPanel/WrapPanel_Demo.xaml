<UserControl x:Class="OpenSilver.Samples.Showcase.WrapPanel_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="200" Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Background="#FFB9CD89"
                            Content="WrapPanel"
                            Foreground="#FFB1C28C"
                            Style="{StaticResource HeaderControl_Style}"/>

            <WrapPanel Name="wrapPanel"
                       Grid.Row="1"
                       Width="100"
                       Height="100"
                       Background="{DynamicResource Theme_ControlBackgroundBrush}">
                <WrapPanel.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FF86A666"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="Width" Value="20"/>
                        <Setter Property="Height" Value="20"/>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </WrapPanel.Resources>

                <Border>
                    <TextBlock Text="1"/>
                </Border>
                <Border Width="30">
                    <TextBlock Text="2"/>
                </Border>
                <Border>
                    <TextBlock Text="3"/>
                </Border>
                <Border Width="25">
                    <TextBlock Text="4"/>
                </Border>
                <Border>
                    <TextBlock Text="5"/>
                </Border>
                <Border Width="15">
                    <TextBlock Text="6"/>
                </Border>
                <Border Width="30">
                    <TextBlock Text="7"/>
                </Border>
            </WrapPanel>

            <ComboBox Grid.Row="2"
                      Margin="0,10,0,0"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding Converter={StaticResource EnumToListConverter}, ConverterParameter={x:Static WrapPanel.OrientationProperty}}"
                      SelectedValue="{Binding Orientation, ElementName=wrapPanel, Mode=TwoWay}"
                      ToolTip="Orientation"/>

            <ComboBox Grid.Row="3"
                      Margin="10"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding Converter={StaticResource EnumToListConverter}, ConverterParameter={x:Static FrameworkElement.FlowDirectionProperty}}"
                      SelectedValue="{Binding FlowDirection, ElementName=wrapPanel, Mode=TwoWay}"
                      ToolTip="FlowDirection"/>

            <local:ViewSourceButton Grid.Row="4" Background="#FFBDE567">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="WrapPanel_Demo.xaml" RelativePath="src/Samples/XAML_Controls/WrapPanel"/>
                    <local:ViewSourceButtonInfo FileName="WrapPanel_Demo.xaml.cs" RelativePath="src/Samples/XAML_Controls/WrapPanel"/>
                    <local:ViewSourceButtonInfo FileName="WrapPanel_Demo.xaml.vb" RelativePath="src/Samples/XAML_Controls/WrapPanel"/>
                    <local:ViewSourceButtonInfo FileName="WrapPanel_Demo.xaml.fs" RelativePath="src/Samples/XAML_Controls/WrapPanel"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
