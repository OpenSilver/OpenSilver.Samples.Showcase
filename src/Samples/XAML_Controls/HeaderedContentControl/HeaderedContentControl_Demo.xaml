<UserControl x:Class="OpenSilver.Samples.Showcase.HeaderedContentControl_Demo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Width="240"
                    Height="250"
                    Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Content="Headered ContentControl"
                            Foreground="#FFA466BA"
                            Style="{StaticResource HeaderControl_Style}"/>

            <HeaderedContentControl Grid.Row="1"
                                    Margin="0,30,0,0"
                                    Padding="5"
                                    HorizontalAlignment="Center"
                                    Header="Header">
                <HeaderedContentControl.HeaderTemplate>
                    <DataTemplate>
                        <Grid Background="{DynamicResource Theme_BorderBrush}">
                            <TextBlock Margin="10,5"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme_TextBrush}"
                                       Text="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </HeaderedContentControl.HeaderTemplate>
                <Border Background="{DynamicResource Theme_AlternateRowBrush}">
                    <TextBlock Foreground="{DynamicResource Theme_TextBrush}"
                               Text="This is the content of the HeaderedContentControl"
                               TextWrapping="Wrap"/>
                </Border>
            </HeaderedContentControl>

            <local:ViewSourceButton Grid.Row="2" Background="#FFA466BA">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo FileName="HeaderedContentControl_Demo.xaml" RelativePath="src/Samples/XAML_Controls/HeaderedContentControl"/>
                    <local:ViewSourceButtonInfo FileName="HeaderedContentControl_Demo.xaml.cs" RelativePath="src/Samples/XAML_Controls/HeaderedContentControl"/>
                    <local:ViewSourceButtonInfo FileName="HeaderedContentControl_Demo.xaml.vb" RelativePath="src/Samples/XAML_Controls/HeaderedContentControl"/>
                    <local:ViewSourceButtonInfo FileName="HeaderedContentControl_Demo.xaml.fs" RelativePath="src/Samples/XAML_Controls/HeaderedContentControl"/>
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
