<Page
    x:Class="OpenSilver.Samples.Showcase.Welcome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="clr-namespace:OpenSilver.Animations;assembly=OpenSilver.Animations"
    xmlns:local="clr-namespace:OpenSilver.Samples.Showcase" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid>
        <local:JsParticlesEffect animations:Animation.OnAppear="{animations:FadeAndScale Delay=500, Duration=1000}"/>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentControl Content="Welcome!" animations:Animation.OnAppear="{animations:FadeAndScale Delay=500, Duration=1000, Bounciness=1}" HorizontalAlignment="Center" Background="{DynamicResource Theme_ControlBackgroundBrush}" Style="{StaticResource WelcomeTitle_Style}"/>
            <animations:AnimatedContentControl animations:Animation.OnAppear="{animations:FadeAndScale Delay=2700, Duration=500, Bounciness=0.3}">
                <Border Background="{DynamicResource Theme_ControlBackgroundBrush}" CornerRadius="30" MaxWidth="600" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,0,40,20">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" Color="Black" BlurRadius="20" Opacity="0.2" />
                    </Border.Effect>
                    <StackPanel Margin="10,16,30,30">
                        <!--<animations:Animation.OnAppear>
                            <animations:FadeAndScale Delay="300"/>
                        </animations:Animation.OnAppear>-->
                        <!--<TextBlock FontSize="14" TextWrapping="Wrap" Margin="22,14,0,0" FontWeight="Bold">WELCOME TO THE OPENSILVER FEATURES SHOWCASE!</TextBlock>-->
                        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="22,20,0,0" FontWeight="Bold" Foreground="#FFD135B7">What is this?</TextBlock>
                        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="22,10,0,0" LineHeight="22">This app contains over 200 small samples that demonstrate OpenSilver’s features. Built with C# and XAML (with VB.NET and F# snippets included), it’s also a great way to learn XAML and explore .NET UI concepts.</TextBlock>
                        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="22,20,0,0" FontWeight="Bold" Foreground="#FFF56301">What is OpenSilver?</TextBlock>
                        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="22,10,0,0" LineHeight="22">
                            <Hyperlink NavigateUri="https://opensilver.net" TargetName="_blank" Foreground="{DynamicResource Theme_TextBrush}">OpenSilver</Hyperlink> is a modern, <Hyperlink NavigateUri="https://github.com/OpenSilver/OpenSilver" TargetName="_blank" Foreground="{DynamicResource Theme_TextBrush}">open-source</Hyperlink> .NET UI framework that’s backward-compatible with WPF and runs cross-platform — on Web, Android, iOS, Windows, macOS, and Linux. It is professionally supported by Userware.
                        </TextBlock>
                        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="22,20,0,0" FontWeight="Bold" Foreground="#FF1D68FF">What's unique about OpenSilver?</TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border CornerRadius="10" Margin="22,10,0,0" Width="150" Padding="14,8" Background="{DynamicResource Theme_TextBrush}" Opacity="0.5" TextBlock.Foreground="{DynamicResource Theme_BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="WPF and Silverlight Compatibility" FontSize="12" LineHeight="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="16">Reuse your WPF skills and modernize existing WPF and Silverlight apps. (New WPF features are added 
                                    <Hyperlink NavigateUri="https://github.com/OpenSilver/OpenSilver/commits/develop/" TargetName="_blank" Foreground="{DynamicResource Theme_BackgroundBrush}">regularly</Hyperlink>).
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Margin="22,10,0,0" Width="150" Padding="14,8" Background="{DynamicResource Theme_TextBrush}" Opacity="0.5" TextBlock.Foreground="{DynamicResource Theme_BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="Web-First XAML Framework" FontSize="12" LineHeight="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="16">Combine .NET with HTML/JavaScript and leverage the vast web ecosystem. Apps maintain pixel-perfect rendering across both web and native platforms.                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Margin="22,10,0,0" Width="150" Padding="14,8" Background="{DynamicResource Theme_TextBrush}" Opacity="0.5" TextBlock.Foreground="{DynamicResource Theme_BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="Integrated XAML UI Designer" FontSize="12" LineHeight="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="16">Design UIs visually with drag-and-drop or AI assistance. Available in the OpenSilver extensions for Visual Studio and VS Code, or try it online at XAML.io — no installation or signup required.</TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="TIP: Use the menu on the left to navigate from page to page." FontSize="12" Foreground="#FF666666" TextWrapping="Wrap" Margin="22,8,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </Border>
            </animations:AnimatedContentControl>
        </StackPanel>
    </Grid>
</Page>
