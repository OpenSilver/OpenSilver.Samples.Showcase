<UserControl
    x:Class="OpenSilver.Showcase.DevExpress_Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
    xmlns:local="clr-namespace:OpenSilver.Showcase">

    <StackPanel>
        <ContentControl Content="DevExpress Blazor UI" Style="{StaticResource PageTitle_Style}"/>
        <controlskit:StaggeredPanel ProgressiveRenderingChunkSize="2">
            <local:DevExpressGrid_Demo HorizontalAlignment="Center"/>
            <local:DevExpressDateEdit_Demo HorizontalAlignment="Center"/>
            <local:DevExpressCarousel_Demo HorizontalAlignment="Center"/>
            <local:DevExpressRichEdit_Demo HorizontalAlignment="Center"/>
        </controlskit:StaggeredPanel>
    </StackPanel>
</UserControl>
