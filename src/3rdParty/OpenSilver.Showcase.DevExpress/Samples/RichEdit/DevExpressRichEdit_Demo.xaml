<UserControl
    x:Class="OpenSilver.Showcase.DevExpressRichEdit_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Rich Text Editor" Foreground="{Binding ColorBrush}" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>

            <Grid Grid.Row="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,20,0,0">
                        <Button Content="Load file..." Margin="5,10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="ButtonLoad_Click"/>
                        <Border Padding="5" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Stretch" BorderThickness="1" BorderBrush="DarkBlue" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock Text="File name:" VerticalAlignment="Center"/>
                                <TextBox x:Name="FileNameTextBox" Grid.Column="1" Text="SomeName" Width="250" Margin="5"/>

                                <Button Grid.Row="1" Grid.ColumnSpan="2"  Content="Save file..." HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="ButtonSave_Click"/>
                            </Grid>
                        </Border>
                        <ToggleButton Content="ReadOnly on/off" IsChecked="{Binding ReadOnly, Mode=TwoWay}" Margin="5,10" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <razor:RazorComponent x:Name="RichEditComponentHolder" Height="820" ScrollMode="Auto">
                        @using global::DevExpress.Blazor
@using global::DevExpress.Blazor.RichEdit

                        <DxRichEdit @ref="myRichEdit"
                            style="height:800px"
                                    DocumentFormat="{Binding FileFormat, Type=global::DevExpress.Blazor.RichEdit.DocumentFormat}"
                                    @bind-DocumentContent="{Binding FileData, Mode=TwoWay, Type=byte[]}"
                                    ReadOnly="{Binding ReadOnly, Type=bool}"/>

@code {
    public DxRichEdit myRichEdit { get; set; }
}

                    </razor:RazorComponent>
                </StackPanel>
            </Grid>

            <local:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.DevExpress/Samples/RichEdit"
FileName="DevExpressRichEdit_Demo.xaml" />
                    <local:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.DevExpress/Samples/RichEdit"
FileName="DevExpressRichEdit_Demo.xaml.cs" />
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
