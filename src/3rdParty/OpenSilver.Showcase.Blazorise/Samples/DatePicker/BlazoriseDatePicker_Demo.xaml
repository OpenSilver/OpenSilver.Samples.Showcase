<UserControl
    x:Class="OpenSilver.Showcase.BlazoriseDatePicker_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Style="{StaticResource Card_Style}" Width="300">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="DatePicker" Foreground="#FFFF81E3" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>

            <StackPanel Grid.Row="1">
                <razor:RazorComponent Margin="0,10,0,0" Height="380">
                    @using Blazorise

                    <DatePicker TValue="DateTime?" @bind-Date="{Binding Date, Mode=TwoWay, Type=DateTime?}" Inline/>
                    
                </razor:RazorComponent>
                <TextBlock Text="{Binding TextForTextBox}"/>
            </StackPanel>

            <local:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Blazorise/Samples/DatePicker"
                        FileName="BlazoriseDatePicker_Demo.xaml" />
                    <local:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Blazorise/Samples/DatePicker"
                        FileName="BlazoriseDatePicker_Demo.xaml.cs" />
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
