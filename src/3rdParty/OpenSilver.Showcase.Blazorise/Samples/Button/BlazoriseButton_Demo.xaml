<UserControl
    x:Class="OpenSilver.Showcase.BlazoriseButton_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Style="{StaticResource Card_Style}" Width="190">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Button" Foreground="#FFFF81E3" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>

            <Grid Grid.Row="1">

                <razor:RazorComponent Margin="0,20,0,0" Height="50">
                    @using Blazorise

                    <Button Color="global::Blazorise.Color.Secondary" Clicked="{Binding ButtonClickDel, Type=Action}" Outline>Click me</Button>
                </razor:RazorComponent>
            </Grid>

            <shared:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Blazorise/Samples/Button"
                        FileName="BlazoriseButton_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Blazorise/Samples/Button"
                        FileName="BlazoriseButton_Demo.xaml.cs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
