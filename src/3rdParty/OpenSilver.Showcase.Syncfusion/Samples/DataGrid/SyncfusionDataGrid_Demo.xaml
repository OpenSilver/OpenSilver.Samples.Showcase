<UserControl
    x:Class="OpenSilver.Showcase.SyncfusionDataGrid_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Style="{StaticResource Card_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="DataGrid" Foreground="#FFFF81E3" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>

            <Grid Grid.Row="1">
                <razor:RazorComponent Height="380" Grid.Row="1" Grid.ColumnSpan="2">
                    @using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids

                    <SfGrid DataSource="{Binding Employees, Type=IQueryable<OpenSilver.Showcase.SyncfusionModel.Employee>}">
                        <GridColumns>
                            <GridColumn Field="FirstName" HeaderText="First Name" Width="150" />
                            <GridColumn Field="LastName" HeaderText="Last Name" Width="150"/>
                            <GridColumn Field="BirthDate" HeaderText="Birth Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="150" />
                            <GridColumn Field="Country" HeaderText="Country" Width="150" />
                            <GridColumn Field="Notes" HeaderText="Notes" />
                        </GridColumns>
                    </SfGrid>
                </razor:RazorComponent>
            </Grid>

            <local:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Syncfusion/Samples/DataGrid"
FileName="SyncfusionDataGrid_Demo.xaml" />
                    <local:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Syncfusion/Samples/DataGrid"
FileName="SyncfusionDataGrid_Demo.xaml.cs" />
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
