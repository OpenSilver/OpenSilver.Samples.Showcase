<UserControl
    x:Class="OpenSilver.Showcase.SyncfusionQRCode_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:local="clr-namespace:OpenSilver.Showcase">


    <ContentControl Style="{StaticResource Card_Style}" Width="235">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="QR Code" Foreground="#FFFF81E3" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>

            <Grid Grid.Row="1">
                <razor:RazorComponent Height="175" Grid.Row="1" Grid.ColumnSpan="2">
                    @using Syncfusion.Blazor
@using Syncfusion.Blazor.BarcodeGenerator

                    <SfQRCodeGenerator Width="200px" Height="150px" Value="https://opensilver.net/">
                        <QRCodeGeneratorDisplayText Text="Visit our website"></QRCodeGeneratorDisplayText>
                    </SfQRCodeGenerator>
                </razor:RazorComponent>
            </Grid>

            <local:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Syncfusion/Samples/QRCode"
FileName="SyncfusionQRCode_Demo.xaml" />
                    <local:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Syncfusion/Samples/QRCode"
FileName="SyncfusionQRCode_Demo.xaml.cs" />
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
