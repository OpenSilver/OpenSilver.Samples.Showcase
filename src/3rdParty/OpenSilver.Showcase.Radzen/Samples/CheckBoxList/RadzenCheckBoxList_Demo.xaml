<UserControl
    x:Class="OpenSilver.Showcase.RadzenCheckBoxList_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Style="{StaticResource Card_Style}" Width="220">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="CheckBoxList" Foreground="#FFFF81E3" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <TextBlock TextWrapping="Wrap">
                    <Run>Currently selected items: </Run>
                    <Run Text="{Binding CheckedItems}"/>
                </TextBlock>
                <razor:RazorComponent Margin="10,20,0,0" Height="140">
                    @using Radzen
                    @using Radzen.Blazor

                    <div class="rz-text-align-center">
                        <RadzenCheckBoxList TValue="int" Orientation="global::Radzen.Orientation.Vertical" Change="{Binding CheckBoxListChangeDel, Type=Action<IEnumerable<int>>}">
                            <Items>
                                <RadzenCheckBoxListItem Text="Orders" Value="1" />
                                <RadzenCheckBoxListItem Text="Employees" Value="2" />
                                <RadzenCheckBoxListItem Text="Customers" Value="3" />
                            </Items>
                        </RadzenCheckBoxList>
                    </div>

                </razor:RazorComponent>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples/CheckBoxList"
                        FileName="RadzenCheckBoxList_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples/CheckBoxList"
                        FileName="RadzenCheckBoxList_Demo.xaml.cs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
