<UserControl
    x:Class="OpenSilver.Showcase.RadzenDataGrid_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    <ContentControl Style="{StaticResource Card_Style}" MinWidth="{Responsive Mobile=300, Tablet=400, Desktop=600}" MaxWidth="650">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="DataGrid" Foreground="#FFFF81E3" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <razor:RazorComponent x:Name="RadzenDemo1" Margin="0,20,0,0" Height="380">
                    @using Radzen
                    @using Radzen.Blazor

                    <RadzenDataGrid PageSize="5" AllowPaging="true" AllowSorting="true" Data="{Binding Employees, Type=IQueryable<OpenSilver.Showcase.RadzenModel.Employee>}" ColumnWidth="400px" >
                        <Columns>
                            <RadzenDataGridColumn Property="FirstName" Title="First Name" Width="150px" />
                            <RadzenDataGridColumn Property="LastName" Title="Last Name" Width="150px"/>
                            <RadzenDataGridColumn Property="BirthDate" Title="Birth Date" FormatString="{0:d}" Width="150px" />
                            <RadzenDataGridColumn Property="Country" Title="Country" Width="150px" />
                            <RadzenDataGridColumn Property="Notes" Title="Notes" />
                        </Columns>
                    </RadzenDataGrid>
                </razor:RazorComponent>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples/DataGrid"
                                                FileName="RadzenDataGrid_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples/DataGrid"
                                                FileName="RadzenDataGrid_Demo.xaml.cs" />
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples"
                                                FileName="Employees.cs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
