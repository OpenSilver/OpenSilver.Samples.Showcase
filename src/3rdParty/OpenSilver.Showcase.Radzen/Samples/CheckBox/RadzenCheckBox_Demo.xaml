<UserControl
    x:Class="OpenSilver.Showcase.RadzenCheckBox_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Style="{StaticResource Card_Style}" Width="190">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="CheckBox" Foreground="#FFFF81E3" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <razor:RazorComponent Margin="0,20,0,0" Height="40">
                    @using Radzen
                    @using Radzen.Blazor

                    <div class="rz-text-align-center">
                        <RadzenCheckBox Name="CheckBox1" @bind-Value="{Binding IsChecked, Mode=TwoWay, Type=Nullable<bool>}"  />
                            <RadzenLabel Text="CheckBox" Component="CheckBox1" class="rz-ms-2" />
                    </div>
                </razor:RazorComponent>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="The checkBox is checked: "/>
                    <Run Text="{Binding IsChecked}"/>
                </TextBlock>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples/CheckBox"
                        FileName="RadzenCheckBox_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples/CheckBox"
                        FileName="RadzenCheckBox_Demo.xaml.cs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
