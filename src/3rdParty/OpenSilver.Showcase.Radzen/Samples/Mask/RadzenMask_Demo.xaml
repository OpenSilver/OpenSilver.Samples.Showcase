<UserControl
    x:Class="OpenSilver.Showcase.RadzenMask_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:local="clr-namespace:OpenSilver.Showcase">


    <ContentControl Style="{StaticResource Card_Style}" Width="300">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Mask" Foreground="#FFFF81E3" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <razor:RazorComponent x:Name="PhoneMaskComponent" Margin="0,10,0,0" Height="100">
                    @using Radzen
                    @using Radzen.Blazor
                    <RadzenStack Orientation="global::Radzen.Orientation.Vertical" AlignItems="global::Radzen.AlignItems.Center" JustifyContent="global::Radzen.JustifyContent.Center" Gap="0.5rem">
                        <RadzenText TextStyle="global::Radzen.Blazor.TextStyle.Subtitle2" TagName="global::Radzen.Blazor.TagName.H3">Telephone</RadzenText>
                        <RadzenMask Mask="(***) ***-****" CharacterPattern="[0-9]" Placeholder="(000) 000-0000" Name="Phone" @bind-Value="{Binding Phone, Mode=TwoWay, Type=string}" Style="width: 100%;" aria-label="Phone" />
                    </RadzenStack>

                </razor:RazorComponent>
                <TextBlock >
                    <Run Text="The phone number entered is "/>
                    <Run Text="{Binding Phone}"/>
                </TextBlock>
            </StackPanel>
            <local:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <local:ViewSourceButton.Sources>
                    <local:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples/Mask"
                        FileName="RadzenMask_Demo.xaml" />
                    <local:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples/Mask"
                        FileName="RadzenMask_Demo.xaml.cs" />
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
