<UserControl
    x:Class="OpenSilver.Showcase.RadzenColorPicker_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">
    
    <ContentControl Style="{StaticResource Card_Style}" Width="200">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="ColorPicker" Foreground="{Binding ColorBrush}" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <razor:RazorComponent Margin="0,20,0,0" Height="60">
                    @using Radzen
                    @using Radzen.Blazor

                    <RadzenColorPicker x:Name="MyRadzenColorPicker" ShowHSV="true" ShowRGBA="true" ShowColors="true" ShowButton="true" Value="{Binding ColorText, Mode=TwoWay, Type=string}" Change="{Binding SetBrushDel, Type=Action<string>}"/>
                </razor:RazorComponent>
            </StackPanel>
            <shared:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples/ColorPicker"
                        FileName="RadzenColorPicker_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.Radzen/Samples/ColorPicker"
                        FileName="RadzenColorPicker_Demo.xaml.cs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
