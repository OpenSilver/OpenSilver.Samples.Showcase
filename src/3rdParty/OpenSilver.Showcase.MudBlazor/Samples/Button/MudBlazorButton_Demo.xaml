<UserControl
    x:Class="OpenSilver.Showcase.MudBlazorButton_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:local="clr-namespace:OpenSilver.Showcase">

    <ContentControl Style="{StaticResource Card_Style}" Width="190">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="Button" Foreground="#FFFF81E3" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0">
                    <ComboBox x:Name="VariantsComboBox" ItemsSource="{Binding Variants}" SelectedValue="{Binding CurrentVariant, Mode=TwoWay}"/>
                </StackPanel>
                <razor:RazorComponent Margin="0,20,0,0" Height="50" Grid.Row="1" Grid.ColumnSpan="2">
                    @using MudBlazor

                    <MudButton x:Name="MyMudButton" Variant="{Binding CurrentVariant, Type=global::MudBlazor.Variant}" OnClick="{Binding ButtonClickDel, Type=Action}">Default</MudButton>
                </razor:RazorComponent>
            </Grid>

            <local:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <local:ViewSourceButton.Sources>
                    <local:ViewMudBlazorSourceInfo RelativePath="src/3rdParty/OpenSilver.Showcase.MudBlazor/Samples/Button"
                        FileName="MudBlazorButton_Demo.xaml" />
                    <local:ViewMudBlazorSourceInfo RelativePath="src/3rdParty/OpenSilver.Showcase.MudBlazor/Samples/Button"
                        FileName="MudBlazorButton_Demo.xaml.cs" />
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
