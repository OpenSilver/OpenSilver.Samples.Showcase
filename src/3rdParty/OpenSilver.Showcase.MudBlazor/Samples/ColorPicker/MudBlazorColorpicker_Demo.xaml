<UserControl
    x:Class="OpenSilver.Showcase.MudBlazorColorPicker_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:shared="clr-namespace:OpenSilver.Showcase;assembly=OpenSilver.Showcase.Shared">

    <ContentControl Style="{StaticResource Card_Style}" Width="200">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="ColorPicker" Foreground="{Binding ColorBrush}" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>

            <Grid Grid.Row="1">
                <razor:RazorComponent Margin="0,20,0,0" Height="100">
                    @using MudBlazor

                    <MudColorPicker @bind-Value="{Binding TheMudColor, Type=global::MudBlazor.Utilities.MudColor, Mode=TwoWay}" ShowToolbar="true" ShowAlpha="true" ShowColorField="true" ShowPreview="true" ShowSliders="true" ShowInputs="true" ShowModeSwitch="true" 
                ColorPickerMode="global::MudBlazor.ColorPickerMode.RGB" />

                </razor:RazorComponent>
            </Grid>

            <shared:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <shared:ViewSourceButton.Sources>
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.MudBlazor/Samples/ColorPicker"
                        FileName="MudBlazorColorpicker_Demo.xaml" />
                    <shared:ViewSourceButtonInfo RelativePath="src/3rdParty/OpenSilver.Showcase.MudBlazor/Samples/ColorPicker"
                        FileName="MudBlazorColorpicker_Demo.xaml.cs" />
                </shared:ViewSourceButton.Sources>
            </shared:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
