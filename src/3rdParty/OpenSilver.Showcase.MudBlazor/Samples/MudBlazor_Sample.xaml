<UserControl
    x:Class="OpenSilver.Showcase.MudBlazor_Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:local="clr-namespace:OpenSilver.Showcase">

    <StackPanel>
        <ContentControl Content="MudBlazor Components" Style="{StaticResource PageTitle_Style}"/>
        <controlskit:StaggeredPanel ProgressiveRenderingChunkSize="2">
            <local:MudBlazorSnackbar_Demo HorizontalAlignment="Center" />
            <local:MudBlazorButton_Demo HorizontalAlignment="Center" />
            <local:MudBlazorDataGrid_Demo HorizontalAlignment="Center" />
            <local:MudBlazorColorPicker_Demo HorizontalAlignment="Center" />
        </controlskit:StaggeredPanel>
        <razor:RazorComponent Margin="0,20,0,0" Height="100">
            @using MudBlazor
            <MudThemeProvider />
            <MudSnackbarProvider />
            <MudPopoverProvider />
        </razor:RazorComponent>
    </StackPanel>
</UserControl>
