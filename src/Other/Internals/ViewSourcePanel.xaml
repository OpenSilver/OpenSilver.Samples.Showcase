<Grid x:Class="OpenSilver.Samples.Showcase.ViewSourcePanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TabControl Name="TabControl"/>

    <Border Grid.Row="1"
            Margin="20,0,0,5"
            Padding="3"
            HorizontalAlignment="Left"
            Background="{DynamicResource Theme_BackgroundBrush}"
            CornerRadius="7">
        <StackPanel Orientation="Horizontal">
            <RadioButton Name="cSharpButton"
                         Checked="OnCSharpRadioButtonChecked"
                         Content="C#"/>
            <RadioButton Checked="OnVBNETRadioButtonChecked" Content="VB.NET"/>
            <RadioButton Checked="OnFSharpRadioButtonChecked" Content="F#"/>
        </StackPanel>
    </Border>
</Grid>
