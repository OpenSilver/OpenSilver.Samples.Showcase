<ContentControl
    x:Class="OpenSilver.Animations.AnimatedContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="clr-namespace:OpenSilver.Animations;assembly=OpenSilver.Animations">
    <ContentControl.Style>
        <Style TargetType="animations:AnimatedContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="animations:AnimatedContentControl">
                        <animations:PercentagePanel
                            x:Name="PART_PercentagePanel"
                            WidthAsPercentageOfChild="{TemplateBinding WidthAsPercentageOfChild}"
                            HeightAsPercentageOfChild="{TemplateBinding HeightAsPercentageOfChild}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </animations:PercentagePanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentControl.Style>
</ContentControl>
