@using Microsoft.AspNetCore.Components.Routing
@inject ILazyFeatureNavigator NavSvc
@implements IDisposable

<Router AppAssembly="@typeof(MauiProgram).Assembly"
        PreferExactMatches="true"
        AdditionalAssemblies="@(NavSvc.Assemblies)"
        OnNavigateAsync="OnNavigateAsync">

    <Found Context="routeData">
        <RouteView RouteData="routeData" />
    </Found>

    <NotFound>
        @if (!_isLoadingRoute)
        {
            <LayoutView>
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        }
    </NotFound>
</Router>

@code {
    private bool _isLoadingRoute;

    protected override void OnInitialized()
    {
        NavSvc.Changed += StateHasChanged;
    }

    public void Dispose()
    {
        NavSvc.Changed -= StateHasChanged;
    }

    private async Task OnNavigateAsync(NavigationContext ctx)
    {
        _isLoadingRoute = true;
        StateHasChanged();
        try
        {
            await NavSvc.EnsureLoadedFromPathAsync(ctx.Path);
        }
        finally
        {
            _isLoadingRoute = false;
            StateHasChanged();
        }
    }
}
