<UserControl
    x:Class="OpenSilver.Samples.Showcase.RadzenListBox_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">


    <ContentControl Style="{StaticResource Card_Style}" Width="300">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="ListBox" Foreground="#FFFF81E3" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>
            <StackPanel Grid.Row="1">
                <razor:RazorComponent Margin="0,20,0,0" Height="400">
                    @using Radzen
                    @using Radzen.Blazor
                    <RadzenStack Orientation="global::Radzen.Orientation.Vertical" AlignItems="global::Radzen.AlignItems.Center" JustifyContent="global::Radzen.JustifyContent.Center" Gap="0.5rem">
                        <RadzenLabel Text="Pick your favorite day" Component="DropDownChangeEvent" />
                        <RadzenListBox TValue="string" Data="{Binding Days}" Style="width: 100%; max-width: 400px;" Name="DropDownChangeEvent" Change="{Binding DropDownChangeDel, Type=Action<object>}" />
                    </RadzenStack>

                </razor:RazorComponent>
                <TextBlock >
                    <Run Text="Your favorite day is "/>
                    <Run Text="{Binding FavoriteDay}"/>
                </TextBlock>
            </StackPanel>
            <local:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
                <local:ViewSourceButton.Sources>
                    <local:ViewRadzenSourceInfo RelativePath="OpenSilver.Samples.Showcase.Radzen/Samples/ListBox"
                        FileName="RadzenListBox_Demo.xaml" />
                    <local:ViewRadzenSourceInfo RelativePath="OpenSilver.Samples.Showcase.Radzen/Samples/ListBox"
                        FileName="RadzenListBox_Demo.xaml.cs" />
                </local:ViewSourceButton.Sources>
            </local:ViewSourceButton>
        </Grid>
    </ContentControl>
</UserControl>
