<UserControl
    x:Class="OpenSilver.Samples.Showcase.GeoBlazor_Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
    xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <StackPanel>
        <ContentControl Content="GeoBlazor Maps" Style="{StaticResource PageTitle_Style}"/>
        <controlskit:StaggeredPanel ProgressiveRenderingChunkSize="2">
            <local:GeoBlazorMap_Demo HorizontalAlignment="Center" />
        </controlskit:StaggeredPanel>
    </StackPanel>
</UserControl>
