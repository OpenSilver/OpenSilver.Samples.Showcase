<UserControl
    x:Class="OpenSilver.Samples.Showcase.Blazorise_Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlskit="clr-namespace:OpenSilver.ControlsKit;assembly=OpenSilver.ControlsKit.Controls"
    xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <StackPanel>
        <TextBlock Text="Blazorise Components" Style="{StaticResource PageHeader_Style}"/>
        <controlskit:StaggeredPanel ProgressiveRenderingChunkSize="2">
            <local:BlazoriseButton_Demo HorizontalAlignment="Center"/>
            <local:BlazoriseTable_Demo HorizontalAlignment="Center"/>
            <local:BlazoriseDatePicker_Demo HorizontalAlignment="Center"/>
            <local:BlazoriseColorPicker_Demo HorizontalAlignment="Center"/>
            
        </controlskit:StaggeredPanel>
    </StackPanel>
</UserControl>
