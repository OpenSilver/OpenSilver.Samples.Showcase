<UserControl
    x:Class="OpenSilver.Samples.Showcase.MudBlazorColorpicker_Demo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:razor="clr-namespace:OpenSilver.Blazor;assembly=OpenSilver.Blazor"
    xmlns:local="clr-namespace:OpenSilver.Samples.Showcase">

    <ContentControl Style="{StaticResource Card_Style}" Width="200">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Content="ColorPicker" Foreground="{Binding ColorBrush}" Background="#FFCB9DC1" Style="{StaticResource HeaderControl_Style}"/>

            <Grid Grid.Row="1">
                <razor:RazorComponent Margin="0,20,0,0" Height="100">
                    @using MudBlazor

                    <MudColorPicker  ValueChanged="{Binding SetBrushDel, Type=Action<global::MudBlazor.Utilities.MudColor>}" ShowToolbar="true" ShowAlpha="true" ShowColorField="true" ShowPreview="true" ShowSliders="true" ShowInputs="true" ShowModeSwitch="true" 
                ColorPickerMode="global::MudBlazor.ColorPickerMode.RGB" />

                </razor:RazorComponent>
            </Grid>

            <!--<local:ViewSourceButton Grid.Row="2" Background="#FFFF81E3">
        <local:ViewSourceButton.Sources>
            <local:ViewSourceButtonInfo RelativePath="OpenSilver.Samples.Showcase.MudBlazor/Samples"
                                        FileName="MudBlazorColorPicker_Demo.xaml" />
            <local:ViewSourceButtonInfo RelativePath="OpenSilver.Samples.Showcase.MudBlazor/Samples"
                                        FileName="MudBlazorColorPicker_Demo.xaml.cs" />
            <local:ViewSourceButtonInfo RelativePath="OpenSilver.Samples.Showcase.MudBlazor/Samples"
                                        FileName="Employees.cs" />
        </local:ViewSourceButton.Sources>
    </local:ViewSourceButton>-->
        </Grid>
    </ContentControl>
</UserControl>
